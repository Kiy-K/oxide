+/// Reorders one non-entry layer by the policy's load order: lexical hits
+/// by rank, then (when balancing) the k-th region of every entry point
+/// before the (k+1)-th of any, then discovery order (the sort is stable).
+fn order(
+    layer: &mut [(RegionId, Origin)],
+    roots: &BTreeMap<RegionId, usize>,
+    lexical: &BTreeMap<EntityId, usize>,
+    balance: bool,
+) {
+    if lexical.is_empty() && !balance {
+        return;
+    }
+    let mut turns: BTreeMap<usize, usize> = BTreeMap::new();
+    let mut keys: BTreeMap<RegionId, (usize, usize, usize)> = BTreeMap::new();
+    for (id, _) in layer.iter() {
+        let rank = lexical.get(&id.anchor).copied().unwrap_or(usize::MAX);
+        let root = roots[id];
+        let turn = turns.entry(root).or_default();
+        let key = if balance {
+            (rank, *turn, root)
+        } else {
+            (rank, 0, 0)
+        };
+        *turn += 1;
+        keys.insert(id.clone(), key);
+    }
+    layer.sort_by_key(|(id, _)| keys[id]);
+}
