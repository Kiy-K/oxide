index 0000000..17ad6dc
--- /dev/null
+++ w/examples/alloc_dump.rs
@@ -0,0 +1,152 @@
+//! Context-allocator utilization research harness. Research-only: opens the
+//! corpus index read-only and runs the real `build_context_with` per task,
+//! mode and allocator challenger (`context::alloc_research`), dumping the
+//! stage trace (seeds, expansion/evidence added and lost, pre-floor pool with
+//! token costs, omission reasons, delivered snippet spans) as JSONL.
+//!
+//! Usage:
+//!   alloc_dump <repo_root> <tasks.jsonl> [--modes fast,balanced,quality]
+//!       [--challengers 0,1,2,3,4] [--blast] [--timing-reps N] > dump.jsonl
+use oxide::context::{alloc_research, build_context_with, ContextOptions};
+use oxide::embeddings::{EmbeddingProvider, GemmaQueryPrompt, NativeEmbedder};
+use oxide::retrieval::{RetrievalEngine, RetrievalMode, SearchMode, SearchOptions, SymbolSnapshot};
+use oxide::storage::{IndexBackend, SqliteStore};
+use serde_json::{json, Value};
+use std::io::{BufRead, Write};
+use std::time::Instant;
+
+fn arg(args: &[String], flag: &str) -> Option<String> {
+    args.iter()
+        .position(|a| a == flag)
+        .and_then(|i| args.get(i + 1).cloned())
+}
+
+fn peak_rss_kb() -> u64 {
+    std::fs::read_to_string("/proc/self/status")
+        .ok()
+        .and_then(|s| {
+            s.lines()
+                .find(|l| l.starts_with("VmHWM:"))
+                .and_then(|l| l.split_whitespace().nth(1)?.parse().ok())
+        })
+        .unwrap_or(0)
+}
+
+fn main() -> anyhow::Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let root = std::path::PathBuf::from(&args[1]).canonicalize()?;
+    let tasks = std::io::BufReader::new(std::fs::File::open(&args[2])?);
+    let modes: Vec<RetrievalMode> = arg(&args, "--modes")
+        .unwrap_or_else(|| "balanced".into())
+        .split(',')
+        .map(|m| RetrievalMode::parse(m).expect("mode"))
+        .collect();
+    let challengers: Vec<u8> = arg(&args, "--challengers")
+        .unwrap_or_else(|| "0".into())
+        .split(',')
+        .map(|c| c.parse().expect("challenger"))
+        .collect();
+    let blast = args.iter().any(|a| a == "--blast");
+    // Julia research arms: `--julia scores.jsonl` ({"id", "scores": {key: p}}), `--tau`.
+    let julia: std::collections::HashMap<String, std::collections::HashMap<String, f32>> =
+        match arg(&args, "--julia") {
+            Some(p) => std::fs::read_to_string(p)?
+                .lines()
+                .filter(|l| !l.trim().is_empty())
+                .map(|l| {
+                    let v: Value = serde_json::from_str(l).unwrap();
+                    (v["id"].as_str().unwrap().to_string(), serde_json::from_value(v["scores"].clone()).unwrap())
+                })
+                .collect(),
+            None => Default::default(),
+        };
+    let tau: f32 = arg(&args, "--tau").map(|t| t.parse().unwrap()).unwrap_or(0.0);
+    let reps: usize = arg(&args, "--timing-reps")
+        .map(|r| r.parse().unwrap())
+        .unwrap_or(2);
+
+    let embedder: Box<dyn EmbeddingProvider> = Box::new(NativeEmbedder::new(
+        oxide::embeddings::DEFAULT_NATIVE_PROFILE,
+        GemmaQueryPrompt::Bare,
+    )?);
+    let store = SqliteStore::open_read_only(&root.join(".oxide/index.db"))?;
+    let snapshot = SymbolSnapshot::load(&store)?;
+    let engine = RetrievalEngine::with_snapshot(&store, embedder.as_ref(), &snapshot);
+    let out = std::io::stdout();
+    let mut out = out.lock();
+    let mut n = 0usize;
+
+    for line in tasks.lines() {
+        let line = line?;
+        if line.trim().is_empty() {
+            continue;
+        }
+        let task: Value = serde_json::from_str(&line)?;
+        let query = task["query"].as_str().unwrap_or_default().to_string();
+        let tid = task["id"].as_str().unwrap_or_default();
+        alloc_research::set_julia(julia.get(tid).cloned(), tau);
+        if challengers.iter().any(|c| matches!(c, 8 | 9)) && !julia.contains_key(tid) {
+            anyhow::bail!("no julia scores for {tid}");
+        }
+
+        let ts = Instant::now();
+        let fused = engine.search(
+            &query,
+            &SearchOptions {
+                limit: 50,
+                mode: SearchMode::Hybrid,
+                expand: false,
+                retrieval_mode: RetrievalMode::Balanced,
+            },
+        )?;
+        let search_ms = ts.elapsed().as_secs_f64() * 1e3;
+        let fused: Vec<Value> = fused
+            .iter()
+            .map(|h| {
+                json!([
+                    format!("{}#{}", h.symbol.file, h.symbol.qualified_name),
+                    h.score,
+                    [h.symbol.start_line, h.symbol.end_line]
+                ])
+            })
+            .collect();
+
+        for &mode in &modes {
+            for &ch in &challengers {
+                let opts = ContextOptions {
+                    retrieval_mode: mode,
+                    blast_radius: blast,
+                    ..Default::default()
+                };
+                alloc_research::set(ch, true);
+                let pack = build_context_with(&root, &engine, &query, &opts)?;
+                let trace = alloc_research::take().unwrap_or(Value::Null);
+                alloc_research::set(ch, false);
+                let mut ms = Vec::new();
+                for _ in 0..reps {
+                    let t = Instant::now();
+                    let p = build_context_with(&root, &engine, &query, &opts)?;
+                    ms.push(t.elapsed().as_secs_f64() * 1e3);
+                    assert_eq!(p.used_tokens, pack.used_tokens, "nondeterministic pack");
+                }
+                let rec = json!({
+                    "id": task["id"], "mode": format!("{mode:?}").to_lowercase(), "tau": tau,
+                    "ch": ch, "blast": blast,
+                    "budget": pack.budget_tokens, "used": pack.used_tokens,
+                    "trace": trace,
+                    "fused50": if ch == 0 { json!(fused) } else { Value::Null },
+                    "search_ms": search_ms, "context_ms": ms,
+                });
+                writeln!(out, "{}", serde_json::to_string(&rec)?)?;
+            }
+        }
+        n += 1;
+    }
+    alloc_research::set(0, false);
+    eprintln!(
+        "{}",
+        json!({"root": root.display().to_string(), "symbols": store.symbol_count()?,
+            "tasks": n, "peak_rss_kb": peak_rss_kb()})
+    );
+    Ok(())
+}
