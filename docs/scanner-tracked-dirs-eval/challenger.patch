+// ---- DIAGNOSTIC CHALLENGER (docs/scanner-tracked-dirs-eval), not main ----
+// `OXIDE_SCANNER_POLICY`: unset/`main` = current behavior; `tracked` = a
+// directory skipped by name may be descended when it holds Git-tracked
+// files, and inside it only tracked files are kept (VCS dirs never);
+// `narrow` = the same, only for build/dist/out/target.
+#[derive(Clone, Copy, PartialEq)]
+enum Policy {
+    Main,
+    Tracked,
+    Narrow,
+}
+
+fn policy() -> Policy {
+    match std::env::var("OXIDE_SCANNER_POLICY").as_deref() {
+        Ok("tracked") => Policy::Tracked,
+        Ok("narrow") => Policy::Narrow,
+        _ => Policy::Main,
+    }
+}
+
+fn overridable(name: &str, policy: Policy) -> bool {
+    match policy {
+        Policy::Main => false,
+        Policy::Tracked => !matches!(name, ".git" | ".hg" | ".svn"),
+        Policy::Narrow => matches!(name, "build" | "dist" | "out" | "target"),
+    }
+}
+
+struct TrackedSet {
+    files: std::collections::HashSet<PathBuf>,
+    dirs: std::collections::HashSet<PathBuf>,
+}
+
+/// `git ls-files -z` relative to `root`; `None` outside a Git work tree,
+/// which makes every policy behave like `main`.
+fn tracked_set(root: &Path) -> Option<TrackedSet> {
+    let out = std::process::Command::new("git")
+        .arg("-C")
+        .arg(root)
+        .args(["ls-files", "-z"])
+        .output()
+        .ok()?;
+    if !out.status.success() {
+        return None;
+    }
+    let mut files = std::collections::HashSet::new();
+    let mut dirs = std::collections::HashSet::new();
+    for raw in out.stdout.split(|b| *b == 0).filter(|b| !b.is_empty()) {
+        let rel = PathBuf::from(String::from_utf8_lossy(raw).into_owned());
+        let mut parent = rel.parent();
+        while let Some(d) = parent {
+            if d.as_os_str().is_empty() || !dirs.insert(d.to_path_buf()) {
+                break;
+            }
+            parent = d.parent();
+        }
+        files.insert(rel);
+    }
+    Some(TrackedSet { files, dirs })
+}
+
+fn has_denied_dir(rel: &Path) -> bool {
+    rel.parent().is_some_and(|p| {
+        p.components().any(|c| matches!(c, std::path::Component::Normal(n)
+            if DENYLIST_DIRS.contains(&n.to_str().unwrap_or(""))))
+    })
+}
+// ---- end challenger ----
+
