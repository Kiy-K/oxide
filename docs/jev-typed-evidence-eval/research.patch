+/// RESEARCH ONLY (#40 G5, `docs/jev-typed-evidence-eval/research.patch`;
+/// never merged). Default state: tracing off and no order override, which
+/// leaves `build_context_with` byte-identical to production. It can do only
+/// two things: (a) record ch5-compatible `trace.packed` snippet spans, and
+/// (b) when an order is set (arm B), replace the score used in the `kept`
+/// sort key. The relevance floor still reads the original scores.
+pub mod jev_research {
+    use std::collections::HashMap;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::sync::Mutex;
+
+    pub static TRACE_ON: AtomicBool = AtomicBool::new(false);
+    pub static TRACE: Mutex<Option<serde_json::Value>> = Mutex::new(None);
+    /// Arm B: `file#qualified_name` -> position in the S+F view order.
+    pub static ORDER: Mutex<Option<HashMap<String, usize>>> = Mutex::new(None);
+
+    pub fn set(trace: bool, order: Option<HashMap<String, usize>>) {
+        TRACE_ON.store(trace, Ordering::SeqCst);
+        *ORDER.lock().unwrap() = order;
+    }
+    pub fn tracing() -> bool {
+        TRACE_ON.load(Ordering::SeqCst)
+    }
+    pub fn order() -> Option<HashMap<String, usize>> {
+        ORDER.lock().unwrap().clone()
+    }
+    pub fn take() -> Option<serde_json::Value> {
+        TRACE.lock().unwrap().take()
+    }
+}
+
+fn research_key(s: &Symbol) -> String {
+    format!("{}#{}", s.file, s.qualified_name)
+}
