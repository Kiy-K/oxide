+//! #40 G5 pack harness (RESEARCH ONLY; docs/jev-typed-evidence-eval/research.patch,
+//! never merged). Opens the corpus index read-only and runs the real
+//! `build_context_with` with default `ContextOptions` (balanced, 4096, no
+//! blast/git) per task, with `context::jev_research` tracing on:
+//!   arm A: no order override;
+//!   arm B: the task's `order` (view keys in S+F order) as the sort override.
+//! Output (one line per task and arm) carries ch5's `score_alloc.pack_metrics`
+//! inputs: {id, arm, budget, used, trace: {packed, used, omitted}, context_ms}.
+//!
+//! Usage: jev_pack <repo_root> <tasks.jsonl> [--arms a|b|ab] > packs.jsonl
+//! Each input line: {"id", "query", "order": ["file#qualified_name", ...] | null}.
+use oxide::context::{build_context_with, jev_research, ContextOptions};
+use oxide::embeddings::open_embedder;
+use oxide::retrieval::{RetrievalEngine, SymbolSnapshot};
+use oxide::storage::SqliteStore;
+use serde_json::{json, Value};
+use std::collections::HashMap;
+use std::io::{BufRead, Write};
+use std::time::Instant;
+
+fn main() -> anyhow::Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let root = std::path::PathBuf::from(&args[1]).canonicalize()?;
+    let tasks = std::io::BufReader::new(std::fs::File::open(&args[2])?);
+    let arms = args
+        .iter()
+        .position(|a| a == "--arms")
+        .and_then(|i| args.get(i + 1).cloned())
+        .unwrap_or_else(|| "ab".into());
+    let embedder = open_embedder(None)?;
+    let store = SqliteStore::open_read_only(&root.join(".oxide/index.db"))?;
+    let snapshot = SymbolSnapshot::load(&store)?;
+    let engine = RetrievalEngine::with_snapshot(&store, embedder.as_ref(), &snapshot);
+    let out = std::io::stdout();
+    let mut out = out.lock();
+    for line in tasks.lines() {
+        let line = line?;
+        if line.trim().is_empty() {
+            continue;
+        }
+        let task: Value = serde_json::from_str(&line)?;
+        let query = task["query"].as_str().unwrap_or_default().to_string();
+        for arm in arms.chars() {
+            let order: Option<HashMap<String, usize>> = match arm {
+                'a' => None,
+                _ => {
+                    let keys = task["order"].as_array();
+                    anyhow::ensure!(keys.is_some(), "arm b needs an order for {}", task["id"]);
+                    let mut m = HashMap::new();
+                    for (i, k) in keys.unwrap().iter().enumerate() {
+                        m.entry(k.as_str().unwrap_or_default().to_string()).or_insert(i);
+                    }
+                    Some(m)
+                }
+            };
+            jev_research::set(true, order);
+            let t = Instant::now();
+            let pack = build_context_with(&root, &engine, &query, &ContextOptions::default())?;
+            let ms = t.elapsed().as_secs_f64() * 1e3;
+            let trace = jev_research::take().unwrap_or(Value::Null);
+            jev_research::set(false, None);
+            let rec = json!({"id": task["id"], "arm": arm.to_string(),
+                "budget": pack.budget_tokens, "used": pack.used_tokens,
+                "trace": trace, "context_ms": [ms]});
+            writeln!(out, "{}", serde_json::to_string(&rec)?)?;
+        }
+    }
+    Ok(())
+}
