index 0000000..cdd1062
--- /dev/null
+++ b/oxide_kernel/crates/kernel/src/semantic.rs
@@ -0,0 +1,92 @@
+//! Semantic channel contract: the OXIDE-owned text an embedding model sees
+//! (one recipe for every model; model prompts are part of the runtime's
+//! embedding space), and the exact-search result the runtime hands
+//! retrieval. The kernel never embeds or searches vectors itself.
+
+use crate::id::{EntityId, SnapshotKey};
+use crate::knowledge::Entity;
+
+/// Names [`document`] and [`query`]. Part of every embedding-space
+/// fingerprint: changing either invalidates every vector built with it.
+pub const SEMANTIC_RECIPE: &str = "oxide-semantic-recipe-v1";
+/// Path plus source bytes one document carries. A token covers at least one
+/// byte on a byte-level tokenizer, so with a prompt of at most 31 bytes a
+/// document fits a 512-token model window without model-side truncation.
+pub const MAX_DOCUMENT_BYTES: usize = 480;
+/// Query bytes sent to a model. Unlike documents this does not prove a
+/// token bound; the runtime rejects a query its model window cannot hold.
+pub const MAX_QUERY_BYTES: usize = 1200;
+
+/// `path\nsource` of a source-backed symbol, cut at a character boundary.
+/// `source` is the symbol's verified captured text. Files, modules and the
+/// repository have no document: their text is not one unit of meaning.
+pub fn document(entity: &Entity, source: &str) -> Option<String> {
+    let EntityId::Symbol(symbol) = &entity.id else {
+        return None;
+    };
+    let text = format!("{}\n{source}", symbol.file().as_str());
+    Some(cut(&text, MAX_DOCUMENT_BYTES).to_owned())
+}
+
+/// The query text a model sees.
+pub fn query(text: &str) -> &str {
+    cut(text, MAX_QUERY_BYTES)
+}
+
+fn cut(s: &str, max: usize) -> &str {
+    let mut end = max.min(s.len());
+    while !s.is_char_boundary(end) {
+        end -= 1;
+    }
+    &s[..end]
+}
+
+/// Nearest neighbours of one query in one embedding space over one
+/// generation, as the runtime's exact search found them. Retrieval ranks
+/// them (score, then [`EntityId`]) and checks the generation.
+#[derive(Debug, Clone, PartialEq)]
+pub struct SemanticResult {
+    pub snapshot: SnapshotKey,
+    /// Names the space and metric. Scores from different scorers are not
+    /// comparable, and none is a relevance probability.
+    pub scorer: String,
+    pub hits: Vec<(EntityId, f64)>,
+    /// More entities scored than `hits` holds.
+    pub truncated: bool,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::id::{RepoPath, Segment, SymbolId};
+
+    fn entity(id: EntityId) -> Entity {
+        Entity {
+            id,
+            kind: "function".into(),
+            name: "f".into(),
+            signature: None,
+            source: None,
+            test: false,
+        }
+    }
+
+    #[test]
+    fn documents_are_bounded_symbol_text_at_char_boundaries() {
+        let file = RepoPath::new("pkg/a.py").unwrap();
+        let path = vec![Segment {
+            name: "f".into(),
+            ordinal: 0,
+        }];
+        let symbol = entity(EntityId::Symbol(SymbolId::new(file.clone(), path).unwrap()));
+        assert_eq!(
+            document(&symbol, "def f(): pass").as_deref(),
+            Some("pkg/a.py\ndef f(): pass")
+        );
+        let long = document(&symbol, &"é".repeat(400)).unwrap();
+        assert!(long.len() <= MAX_DOCUMENT_BYTES && long.len() >= MAX_DOCUMENT_BYTES - 1);
+        assert_eq!(document(&entity(EntityId::File(file)), "x"), None);
+        assert_eq!(query(&"q".repeat(5000)).len(), MAX_QUERY_BYTES);
+        assert_eq!(query("short"), "short");
+    }
+}
