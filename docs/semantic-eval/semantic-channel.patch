diff --git a/oxide_kernel/crates/runtime/tests/semantic_pilot.rs b/oxide_kernel/crates/runtime/tests/semantic_pilot.rs
new file mode 100644
index 0000000..4cd0762
--- /dev/null
+++ b/oxide_kernel/crates/runtime/tests/semantic_pilot.rs
@@ -0,0 +1,511 @@
+//! Semantic channel pilot (docs/semantic-eval/README.md): OXIDE's lexical
+//! channel alone, an embedding space alone, lexical + embeddings (append
+//! and RRF), and a body-text BM25 control fused the same way, through the
+//! real pipeline (routing, selection, packing) on dev. Opt-in and
+//! machine-local; it never calls JEV. Vectors come from the persistent
+//! cache, or from a capped llama-server for the ones it lacks:
+//!
+//! ```text
+//! OXIDE_CB_WORKTREES=<dir>:<dir> OXIDE_SEMANTIC_SPACE=lfm|eg2 \
+//!   OXIDE_SEMANTIC_REPOS=<repo>,<repo> [OXIDE_SEMANTIC_URL=http://127.0.0.1:8091] \
+//!   [OXIDE_SEMANTIC_ESTIMATE=1 | OXIDE_SEMANTIC_CALIBRATE=1] \
+//!   cargo test --release -p oxide-runtime --test semantic_pilot -- --ignored --nocapture
+//! ```
+//!
+//! `ESTIMATE` counts what would be embedded (no runner); `CALIBRATE`
+//! prints the served space so its canary can be pinned in [`space`].
+
+mod common;
+
+use std::collections::{BTreeMap, BTreeSet, HashMap};
