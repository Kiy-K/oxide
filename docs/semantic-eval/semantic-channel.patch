+#[test]
+fn appended_semantic_hits_follow_lexical_rank_and_merge_duplicates() {
+    let view = view();
+    let lexical_only = retrieve(
+        &view,
+        &query("test_h"),
+        &QueryContext::default(),
+        ChannelState::Unconfigured.into(),
+        BASELINE,
+    )
+    .unwrap();
+    // Unordered on purpose: retrieval ranks by score, then identity.
+    let hits = [(c(), 0.1), (test_h(), 0.5), (g(), 0.9), (f0(), 0.4)];
+    let set = retrieve(
+        &view,
+        &query("test_h"),
+        &QueryContext::default(),
+        semantic(&hits, Fusion::Append { depth: 3 }),
+        BASELINE,
+    )
+    .unwrap();
+    let n = lexical_only.entries.len();
+    assert_eq!(ids(&set)[..n], ids(&lexical_only)[..]);
+    assert_eq!(ids(&set)[n..], [g(), f0()]);
+    assert_eq!(
+        channels(&get(&set, &test_h())),
+        [(Channel::Lexical, 1), (Channel::Semantic, 2)]
+    );
+    assert_eq!(set.fusion, Some(Fusion::Append { depth: 3 }));
+    let ran = ChannelState::Ran {
+        scorer: "cosine:test".into(),
+        returned: 3,
+        truncated: true,
+    };
+    assert_eq!(set.channels[1].state, ran);
+
+    // Semantic-only: lexical disabled, entries are the semantic rank.
+    let only = RetrievalConfig {
+        lexical: false,
+        ..BASELINE
+    };
+    let set = retrieve(
+        &view,
+        &query("test_h"),
+        &QueryContext::default(),
+        semantic(&hits, Fusion::Append { depth: 3 }),
+        only,
+    )
+    .unwrap();
+    assert_eq!(ids(&set), [g(), test_h(), f0()]);
+    assert_eq!(set.channels[0].state, ChannelState::Disabled);
+}
+
+#[test]
+fn reciprocal_rank_fusion_orders_by_fused_rank_and_records_its_cut() {
+    let view = view();
+    let hits = [(g(), 0.9), (test_h(), 0.5)];
+    let rrf = Fusion::Rrf {
+        k: 60,
+        lexical: 600,
+        semantic: 400,
+        depth: 2,
+        keep: 2,
+    };
+    let set = retrieve(
+        &view,
+        &query("test_h"),
+        &QueryContext::default(),
+        semantic(&hits, rrf),
+        BASELINE,
+    )
+    .unwrap();
+    // In both channels, so first; evidence of each kept with its own rank.
+    assert_eq!(set.entries[0].entity, test_h());
+    assert_eq!(
+        channels(&set.entries[0]),
+        [(Channel::Lexical, 1), (Channel::Semantic, 2)]
+    );
+    assert_eq!(set.entries.len(), 2);
+    let lexical_only = retrieve(
+        &view,
+        &query("test_h"),
+        &QueryContext::default(),
+        ChannelState::Unconfigured.into(),
+        BASELINE,
+    )
+    .unwrap();
+    let mut union = ids(&lexical_only);
+    union.extend([g(), test_h()]);
+    union.sort();
+    union.dedup();
+    assert_eq!(set.fusion_omitted, union.len() - 2);
+    assert_eq!(set.fusion, Some(rrf));
+}
+
+#[test]
+fn unusable_semantic_hits_leave_the_channel_unavailable_and_lexical_intact() {
+    let view = view();
+    let baseline = retrieve(
+        &view,
+        &query("test_h"),
+        &QueryContext::default(),
