+//! Optional semantic channel (SPEC § Embedding providers, § Retrieval): a
+//! persistent, content-addressed vector cache per embedding space, a
+//! per-generation index built in the background, and exact cosine search.
+//! Requests never wait for a build: until a generation's index is ready
+//! the channel is unavailable and retrieval stays lexical/structural.
+
+use std::collections::{BTreeMap, HashMap};
+use std::fs::{File, OpenOptions};
+use std::io::{self, Read, Seek, SeekFrom, Write};
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+
+use oxide_kernel::id::{EntityId, SnapshotKey};
+use oxide_kernel::query::Query;
+use oxide_kernel::retrieve::{ChannelState, Fusion, Semantic};
+use oxide_kernel::semantic::{self as recipe, SemanticResult};
+use oxide_kernel::source::{SourceProvider, Sources};
+use oxide_kernel::store::{MAX_REQUEST_ITEMS, ReadView, StoreError};
+use sha2::{Digest as _, Sha256};
+
+use crate::embedding::{Compatibility, EmbedError, EmbeddingProvider, EmbeddingSpace, embed_all};
+
+/// Cache file header; the format of every record after it.
+const MAGIC: &[u8; 8] = b"OXVC1\0\0\0";
+
+type Key = [u8; 32];
+
+fn key(text: &str) -> Key {
+    Sha256::digest(text.as_bytes()).into()
+}
+
+/// Vectors by the exact text a model embedded, for one embedding space.
+/// Keys cover source, recipe and prompt; the directory covers the space,
+/// so a changed model, quantization, runner build or canary never reuses a
+/// vector. One process owns a cache at a time (an exclusive file lock).
+pub struct VectorCache {
+    file: File,
+    dimension: usize,
+    vectors: HashMap<Key, Vec<f32>>,
+}
+
+impl VectorCache {
+    /// Opens (or creates) `root`'s cache for `space`. A record cut short by
+    /// a crash is dropped; anything else malformed is an error, never
+    /// silently reused.
+    pub fn open(root: &Path, space: &EmbeddingSpace) -> io::Result<Self> {
+        // The fingerprint's Debug text names the directory: any field
+        // change, including a new field, is a new space.
+        let fingerprint = format!("{space:?}");
+        let id = crate::decisionbench::sha256_hex(fingerprint.as_bytes());
+        let dir = root.join(&id[..32]);
+        std::fs::create_dir_all(&dir)?;
+        let named = dir.join("space.txt");
+        match std::fs::read_to_string(&named) {
+            Ok(text) if text == fingerprint => {}
+            Ok(_) => return Err(io::Error::other("cache directory names another space")),
+            Err(e) if e.kind() == io::ErrorKind::NotFound => std::fs::write(&named, &fingerprint)?,
+            Err(e) => return Err(e),
+        }
+        let mut file = OpenOptions::new()
+            .read(true)
+            .append(true)
+            .create(true)
+            .open(dir.join("vectors.bin"))?;
+        file.try_lock()
+            .map_err(|_| io::Error::other("vector cache is in use by another owner"))?;
+        let dimension = space.dimension as usize;
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes)?;
+        if bytes.is_empty() {
+            file.write_all(MAGIC)?;
+            file.write_all(&(dimension as u32).to_le_bytes())?;
+            bytes.extend_from_slice(MAGIC);
+            bytes.extend_from_slice(&(dimension as u32).to_le_bytes());
+        }
+        if bytes.len() < 12
+            || &bytes[..8] != MAGIC
+            || bytes[8..12] != (dimension as u32).to_le_bytes()
+        {
+            return Err(io::Error::other("vector cache header does not match"));
+        }
+        let record = 32 + 4 * dimension;
+        let whole = (bytes.len() - 12) / record * record + 12;
+        if whole < bytes.len() {
+            file.set_len(whole as u64)?;
+            file.seek(SeekFrom::End(0))?;
+        }
+        let mut vectors = HashMap::new();
+        for r in bytes[12..whole].chunks_exact(record) {
+            let vector = r[32..]
+                .as_chunks::<4>()
+                .0
+                .iter()
+                .map(|b| f32::from_le_bytes(*b))
+                .collect();
+            vectors.insert(r[..32].try_into().unwrap(), vector);
+        }
+        Ok(Self {
+            file,
+            dimension,
+            vectors,
+        })
+    }
+
+    pub fn len(&self) -> usize {
+        self.vectors.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.vectors.is_empty()
+    }
+
+    fn put(&mut self, text: &str, vector: Vec<f32>) -> io::Result<()> {
+        debug_assert_eq!(vector.len(), self.dimension);
+        let k = key(text);
+        let mut record = Vec::with_capacity(32 + 4 * vector.len());
+        record.extend_from_slice(&k);
+        vector
+            .iter()
+            .for_each(|x| record.extend_from_slice(&x.to_le_bytes()));
+        self.file.write_all(&record)?;
+        self.vectors.insert(k, vector);
+        Ok(())
+    }
+}
+
+/// Every source-backed symbol's [`recipe::document`], hydrated through the
+/// pinned view and verified against its digest. Symbols whose bytes are not
+/// retained, do not verify or are not UTF-8 get no document (no vector).
+pub fn documents<V: ReadView + SourceProvider>(
+    view: &V,
+    symbols: &[EntityId],
+) -> Result<Vec<(EntityId, String)>, StoreError> {
+    let mut sources = Sources::new(view);
+    let mut out = Vec::new();
+    for chunk in symbols.chunks(MAX_REQUEST_ITEMS) {
+        for entity in view.entities(chunk)?.into_iter().flatten() {
+            let Some(source) = &entity.source else {
+                continue;
+            };
+            let Ok(bytes) = sources.file(&source.file, &source.digest)? else {
+                continue;
+            };
+            let range = source.range.start as usize..source.range.end as usize;
+            let Some(text) = bytes.get(range).and_then(|b| std::str::from_utf8(b).ok()) else {
+                continue;
+            };
+            if let Some(document) = recipe::document(&entity, text) {
+                out.push((entity.id.clone(), document));
+            }
+        }
+    }
+    Ok(out)
+}
+
+/// One generation's vectors in one space, for exact search.
+pub struct SemanticIndex {
+    pub snapshot: SnapshotKey,
+    pub space: EmbeddingSpace,
+    /// What the runner served when the index was built; see
+    /// [`EmbeddingProvider::served`].
+    served: Option<String>,
+    ids: Vec<EntityId>,
+    vectors: Vec<f32>,
+}
+
+impl SemanticIndex {
+    pub fn len(&self) -> usize {
+        self.ids.len()
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.ids.is_empty()
+    }
+
+    /// Exact cosine top-`depth` for `query` (vectors are normalized, so the
+    /// dot product), ties by [`EntityId`]. Refuses to embed the query if the
+    /// runner no longer serves what the index was built with.
+    pub fn search(
+        &self,
+        provider: &dyn EmbeddingProvider,
+        query: &Query,
+        depth: usize,
+        timeout: Duration,
+    ) -> Result<SemanticResult, EmbedError> {
+        let deadline = Instant::now() + timeout;
+        if self.served.is_some() && provider.served(timeout)? != self.served {
+            return Err(EmbedError::Rejected(
+                "runner now serves another model".into(),
+            ));
+        }
+        let prompt = self.space.query_prompt.as_deref().unwrap_or_default();
+        let text = vec![format!("{prompt}{}", recipe::query(&query.text))];
+        let never = AtomicBool::new(false);
+        let q = embed_all(provider, &self.space, 1, &text, deadline, &never)?.remove(0);
+        let dimension = q.len();
+        let mut scored: Vec<(f64, usize)> = self
+            .vectors
+            .chunks_exact(dimension)
+            .enumerate()
+            .map(|(i, v)| (v.iter().zip(&q).map(|(a, b)| a * b).sum::<f32>() as f64, i))
+            .collect();
+        scored.sort_by(|a, b| {
+            b.0.total_cmp(&a.0)
+                .then_with(|| self.ids[a.1].cmp(&self.ids[b.1]))
+        });
+        let truncated = scored.len() > depth;
+        scored.truncate(depth);
+        let digest = self.space.model_digest.as_deref().unwrap_or("unverified");
+        Ok(SemanticResult {
+            snapshot: self.snapshot.clone(),
+            scorer: format!(
+                "cosine:{}@{}",
+                self.space.model,
+                &digest[..digest.len().min(19)]
+            ),
+            hits: scored
+                .into_iter()
+                .map(|(s, i)| (self.ids[i].clone(), s))
+                .collect(),
+            truncated,
+        })
+    }
+
+    /// The semantic channel for one request: hits fused by `fusion`, or the
+    /// visible reason there are none. Never fails the request.
+    pub fn channel(
+        &self,
+        provider: &dyn EmbeddingProvider,
+        query: &Query,
+        fusion: Fusion,
+        timeout: Duration,
+    ) -> Semantic {
+        let depth = match fusion {
+            Fusion::Append { depth } | Fusion::Rrf { depth, .. } => depth,
+        };
+        match self.search(provider, query, depth, timeout) {
+            Ok(result) => Semantic::Ran { result, fusion },
+            Err(e) => ChannelState::Unavailable(format!("query embedding: {e:?}")).into(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct BuildStats {
+    pub documents: usize,
+    pub unique_texts: usize,
+    pub cached: usize,
+    pub embedded: usize,
+    pub seconds_embedding: u64,
+}
+
+#[derive(Debug, Default)]
+struct Progress {
+    done: AtomicUsize,
+    total: AtomicUsize,
+}
+
+/// A generation's index being built on its own thread. Nothing waits on
+/// it: [`Build::pending`] is the channel state requests use meanwhile.
+pub struct Build {
+    progress: Arc<Progress>,
+    cancel: Arc<AtomicBool>,
+    handle: JoinHandle<Result<(SemanticIndex, BuildStats), String>>,
+}
+
+impl Build {
+    /// Probes `provider` and refuses to embed unless it serves exactly
+    /// `space`; then embeds what `cache_root`'s cache lacks, `batch_timeout`
+    /// per batch, storing each batch as it lands so a cancelled or failed
+    /// build keeps its progress.
+    pub fn spawn(
+        provider: Box<dyn EmbeddingProvider + Send>,
+        space: EmbeddingSpace,
+        cache_root: PathBuf,
+        snapshot: SnapshotKey,
+        documents: Vec<(EntityId, String)>,
+        batch_timeout: Duration,
+    ) -> Build {
+        let progress = Arc::new(Progress::default());
+        let cancel = Arc::new(AtomicBool::new(false));
+        let (p, c) = (progress.clone(), cancel.clone());
+        let handle = std::thread::spawn(move || {
+            let probe = provider
+                .probe(batch_timeout)
+                .map_err(|e| format!("probe: {e:?}"))?;
+            match space.compare(&probe.space) {
+                Compatibility::Same => {}
+                other => return Err(format!("runner space is {other:?}: {:?}", probe.space)),
+            }
+            let served = provider
+                .served(batch_timeout)
+                .map_err(|e| format!("{e:?}"))?;
+            let mut cache = VectorCache::open(&cache_root, &space).map_err(|e| e.to_string())?;
+            let prompt = space.document_prompt.clone().unwrap_or_default();
+            let texts: Vec<String> = documents
+                .iter()
+                .map(|(_, d)| format!("{prompt}{d}"))
+                .collect();
+            let mut unique: BTreeMap<Key, &String> = BTreeMap::new();
+            for t in &texts {
+                unique.entry(key(t)).or_insert(t);
+            }
+            let missing: Vec<String> = unique
+                .iter()
+                .filter(|(k, _)| !cache.vectors.contains_key(*k))
+                .map(|(_, t)| (*t).clone())
+                .collect();
+            p.total.store(missing.len(), Ordering::Relaxed);
+            let started = Instant::now();
+            for batch in missing.chunks(probe.max_batch.max(1)) {
+                let vectors = embed_all(
+                    provider.as_ref(),
+                    &space,
+                    probe.max_batch,
+                    batch,
+                    Instant::now() + batch_timeout,
+                    &c,
+                )
+                .map_err(|e| format!("embedding: {e:?}"))?;
+                for (text, vector) in batch.iter().zip(vectors) {
+                    cache.put(text, vector).map_err(|e| e.to_string())?;
+                }
+                p.done.fetch_add(batch.len(), Ordering::Relaxed);
+            }
+            let stats = BuildStats {
+                documents: documents.len(),
+                unique_texts: unique.len(),
+                cached: unique.len() - missing.len(),
+                embedded: missing.len(),
+                seconds_embedding: started.elapsed().as_secs(),
+            };
+            let mut vectors = Vec::with_capacity(texts.len() * space.dimension as usize);
+            for t in &texts {
+                vectors.extend_from_slice(&cache.vectors[&key(t)]);
+            }
+            let index = SemanticIndex {
+                snapshot,
+                space,
+                served,
+                ids: documents.into_iter().map(|(id, _)| id).collect(),
+                vectors,
+            };
+            Ok((index, stats))
+        });
+        Build {
+            progress,
+            cancel,
+            handle,
+        }
+    }
+
+    /// (embedded, to embed) so far.
+    pub fn progress(&self) -> (usize, usize) {
+        let p = &self.progress;
+        (
+            p.done.load(Ordering::Relaxed),
+            p.total.load(Ordering::Relaxed),
+        )
+    }
+
+    pub fn cancel(&self) {
+        self.cancel.store(true, Ordering::Relaxed);
+    }
+
+    pub fn is_finished(&self) -> bool {
+        self.handle.is_finished()
+    }
+
+    /// The channel state for requests while the build runs.
+    pub fn pending(&self) -> ChannelState {
+        let reason = match self.progress() {
+            // Still probing the runner or loading the cache.
+            (_, 0) => "vectors building".to_owned(),
+            (done, total) => format!("vectors building {done}/{total}"),
+        };
+        ChannelState::Unavailable(reason)
+    }
+
+    pub fn join(self) -> Result<(SemanticIndex, BuildStats), String> {
+        self.handle
+            .join()
+            .map_err(|_| "build thread panicked".to_owned())?
+    }
+}
