+                    .find_map(|l| l.strip_prefix("content-length:"))
+                    .map_or(0, |v| v.trim().parse().unwrap());
+                while raw.len() < end + length {
+                    let n = stream.read(&mut buf).unwrap();
+                    raw.extend_from_slice(&buf[..n]);
+                }
+                let path = head
+                    .split_whitespace()
+                    .nth(1)
+                    .unwrap_or_default()
+                    .to_owned();
+                let (status, body) = match path.as_str() {
+                    "/props" => (200, props.clone()),
+                    "/v1/models" => (200, models.clone()),
+                    _ => embeddings.next().unwrap(),
+                };
+                let reply = format!(
+                    "HTTP/1.1 {status} X\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                    body.len()
+                );
+                let _ = stream.write_all(reply.as_bytes());
+            }
+        });
+        url
+    }
+
+    fn vectors(vs: &[[f32; 4]], tokens: u32) -> (u16, String) {
+        let data: Vec<Value> = vs
+            .iter()
+            .enumerate()
+            .map(|(i, v)| json!({"object": "embedding", "index": i, "embedding": v}))
+            .collect();
+        let usage = json!({"prompt_tokens": tokens, "total_tokens": tokens});
+        let body = json!({"object": "list", "model": "lfm", "data": data, "usage": usage});
+        (200, body.to_string())
+    }
+
