+const BUDGETS: [u32; 3] = [256, 1024, 4096];
+/// Channel depth for every fused configuration: the lexical baseline's 20.
+const DEPTH: usize = 20;
+/// Hits kept for channel-only Recall@K and MRR.
+const RANKED: usize = 100;
+const QUERY_TIMEOUT: Duration = Duration::from_secs(30);
+const BATCH_TIMEOUT: Duration = Duration::from_secs(300);
+/// Tokens per document byte measured in the 2026-10-11 standalone pilot
+/// (106 tokens per ~545-byte document), for cost estimates only.
+const TOKENS_PER_BYTE: f64 = 0.195;
+/// Embedding throughput measured there under the 2-core cap (tokens/s).
+const TOKENS_PER_SECOND: f64 = 260.0;
+
+/// The configured spaces: explicit identity, never discovered.
+fn space(name: &str) -> EmbeddingSpace {
+    let base = EmbeddingSpace {
+        runner: Runner::LlamaCpp,
+        model: String::new(),
+        model_digest: None,
+        quantization: None,
+        dimension: 0,
+        metric: Metric::Cosine,
+        normalized: Some(true),
+        pooling: None,
+        tokenizer: None,
+        query_prompt: None,
+        document_prompt: None,
+        document_recipe: recipe::SEMANTIC_RECIPE.into(),
+        runner_version: Some("b11540-1e6f04a75".into()),
+        max_tokens: None,
+        canary: None,
+    };
+    match name {
+        // LiquidAI/LFM2.5-Embedding-350M-GGUF, LFM Open License v1.0.
+        "lfm" => EmbeddingSpace {
+            model: "LFM2.5-Embedding-350M".into(),
+            model_digest: Some(
+                "sha256:4d7aa9dc6406a10fc3dec2c11f8f06781af063bf49211b8e4132e9b876d3f32a".into(),
+            ),
+            quantization: Some("Q4_K - Medium".into()),
+            dimension: 1024,
+            pooling: Some("cls".into()),
+            tokenizer: Some("lfm2".into()),
+            query_prompt: Some("query: ".into()),
+            document_prompt: Some("document: ".into()),
+            max_tokens: Some(512),
+            canary: canary("OXIDE_SEMANTIC_CANARY_LFM"),
+            ..base
+        },
+        // ggml-org/embeddinggemma-2-GGUF text layer, Apache-2.0.
+        "eg2" => EmbeddingSpace {
+            model: "embeddinggemma-2-text".into(),
+            model_digest: Some(
+                "sha256:2188ac1deca4b77dffefd603c2776a9d76d9d74ec01841392982ebb840b09135".into(),
+            ),
+            quantization: Some("Q8_0".into()),
+            dimension: 768,
+            pooling: Some("mean".into()),
+            tokenizer: Some("gemma".into()),
+            query_prompt: Some("task: code retrieval | query: ".into()),
+            document_prompt: Some("title: none | text: ".into()),
+            // The capped server's physical batch, below the model's 8K.
+            max_tokens: Some(1024),
+            canary: canary("OXIDE_SEMANTIC_CANARY_EG2"),
+            ..base
+        },
+        other => panic!("unknown space {other}"),
+    }
+}
+
+/// A pinned canary, as `CALIBRATE` printed it (comma-separated).
+fn canary(var: &str) -> Option<Vec<i32>> {
+    let text = std::env::var(var).ok()?;
+    Some(text.split(',').map(|x| x.trim().parse().unwrap()).collect())
+}
+
+/// BM25 over the same documents the model embeds, with OXIDE's lexical
+/// terms and the production FTS parameters: the control for "the channel
+/// sees symbol bodies", separating that from what the model adds.
+fn bm25_control(docs: &[(EntityId, String)], query: &str, depth: usize) -> Vec<(EntityId, f64)> {
+    let (k1, b) = (1.2, 0.75);
+    let bags: Vec<HashMap<String, f64>> = docs
+        .iter()
+        .map(|(_, d)| {
+            let mut bag = HashMap::new();
+            terms(d)
+                .into_iter()
+                .for_each(|t| *bag.entry(t).or_default() += 1.0);
+            bag
+        })
+        .collect();
+    let lengths: Vec<f64> = bags.iter().map(|b| b.values().sum()).collect();
+    let average = lengths.iter().sum::<f64>() / lengths.len().max(1) as f64;
+    let wanted: BTreeSet<String> = terms(recipe::query(query)).into_iter().collect();
+    let n = docs.len() as f64;
+    let idf: HashMap<&String, f64> = wanted
+        .iter()
+        .map(|t| {
+            let df = bags.iter().filter(|b| b.contains_key(t)).count() as f64;
+            (t, (1.0 + (n - df + 0.5) / (df + 0.5)).ln())
+        })
+        .collect();
+    let mut scored: Vec<(EntityId, f64)> = bags
+        .iter()
+        .zip(&lengths)
+        .zip(docs)
+        .filter_map(|((bag, len), (id, _))| {
+            let s: f64 = wanted
+                .iter()
+                .filter_map(|t| {
+                    let f = *bag.get(t)?;
+                    Some(idf[t] * f * (k1 + 1.0) / (f + k1 * (1.0 - b + b * len / average)))
+                })
+                .sum();
+            (s > 0.0).then(|| (id.clone(), s))
+        })
+        .collect();
+    scored.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+    scored.truncate(depth);
+    scored
+}
+
+/// Recall@K and MRR of `gold` in a ranked list.
+fn ranked(list: &[EntityId], gold: &BTreeSet<EntityId>) -> Value {
+    let at = |k: usize| list.iter().take(k).filter(|e| gold.contains(e)).count() as f64;
+    let n = gold.len().max(1) as f64;
+    let first = list.iter().position(|e| gold.contains(e));
+    json!({"r10": at(10) / n, "r20": at(20) / n, "r40": at(40) / n, "r100": at(100) / n,
+           "mrr": first.map_or(0.0, |p| 1.0 / (p + 1) as f64), "gold": gold.len()})
+}
+
+fn ids(hits: &[(EntityId, f64)]) -> Vec<EntityId> {
+    hits.iter().map(|(e, _)| e.clone()).collect()
+}
+
+fn configs(
+    semantic: &SemanticResult,
+    control: &SemanticResult,
+) -> Vec<(&'static str, RetrievalConfig, Semantic)> {
+    let no_lexical = RetrievalConfig {
+        lexical: false,
+        ..BASELINE
+    };
+    let append = Fusion::Append { depth: DEPTH };
+    let rrf = Fusion::Rrf {
+        k: 60,
+        lexical: 600,
+        semantic: 400,
+        depth: DEPTH,
+        keep: DEPTH,
+    };
+    let ran = |r: &SemanticResult, fusion| Semantic::Ran {
+        result: r.clone(),
+        fusion,
+    };
+    vec![
+        ("lexical", BASELINE, ChannelState::Unconfigured.into()),
+        ("semantic", no_lexical, ran(semantic, append)),
+        ("lexical+semantic", BASELINE, ran(semantic, append)),
+        ("rrf", BASELINE, ran(semantic, rrf)),
+        ("control", no_lexical, ran(control, append)),
+        ("lexical+control", BASELINE, ran(control, append)),
+        ("rrf-control", BASELINE, ran(control, rrf)),
+    ]
+}
+
+fn measure(t: &Value, space: &EmbeddingSpace, client: LlamaCpp, cache: &Path) -> Value {
+    let Indexed {
+        store,
+        key,
+        gold,
+        dir,
+        symbols,
+        index_seconds,
+        ..
+    } = phase5::index_task(t, &data_dir());
+    let view = store.open(&key).unwrap();
+    let docs = documents(&view, &symbols).unwrap();
+    let query = Query {
+        text: t["query"].as_str().unwrap().into(),
+    };
+    let input = TaskInput {
+        id: t["id"].as_str().unwrap(),
+        repository: t["repo"].as_str().unwrap(),
+        split: Split::Dev,
+        query: &query.text,
+        symbols: Vec::new(),
+        gold: gold.clone(),
+    };
+    let all: Vec<EntityId> = gold.verified.iter().cloned().collect();
+    let all_sources = gold_sources(&view, &all);
+    let gold_symbols: Vec<EntityId> = all
+        .iter()
+        .filter(|g| matches!(g, EntityId::Symbol(_)))
+        .cloned()
+        .collect();
+    let symbol_sources = gold_sources(&view, &gold_symbols);
+    let gold_set: BTreeSet<EntityId> = gold_symbols.iter().cloned().collect();
+    let embedded: BTreeSet<&EntityId> = docs.iter().map(|(e, _)| e).collect();
+
+    // Build in the background; requests meanwhile run lexical-only.
+    let build = Build::spawn(
+        Box::new(client),
+        space.clone(),
+        cache.into(),
+        key.clone(),
+        docs.clone(),
+        BATCH_TIMEOUT,
+    );
+    let mut during = phase5::request(&input, 1024);
+    during.semantic = build.pending().into();
+    let started = Instant::now();
+    let served = build_context(&view, &view, &during, &baseline(), None).unwrap();
+    let during_build_ms = started.elapsed().as_secs_f64() * 1e3;
+    let degraded_during_build = format!("{:?}", served.bundle.degraded.first());
+    let mut last = Instant::now();
+    while !build.is_finished() {
+        std::thread::sleep(Duration::from_millis(200));
+        if last.elapsed() > Duration::from_secs(30) {
+            eprintln!("  {} vectors {:?}", input.id, build.progress());
+            last = Instant::now();
+        }
+    }
+    let (index, stats) = build
+        .join()
+        .unwrap_or_else(|e| panic!("{}: build: {e}", input.id));
+    let client = LlamaCpp::new(endpoint(), space.clone(), 16);
+
+    let timed = |index: &SemanticIndex| {
+        let t0 = Instant::now();
+        let r = index
+            .search(&client, &query, RANKED, QUERY_TIMEOUT)
+            .unwrap();
+        (r, t0.elapsed().as_secs_f64() * 1e3)
+    };
+    let (semantic, cold_ms) = timed(&index);
+    let warm: Vec<f64> = (0..5).map(|_| timed(&index).1).collect();
+    let control = SemanticResult {
+        snapshot: key.clone(),
+        scorer: "control:bm25-body;oxide-terms;k1=1.2;b=0.75".into(),
+        hits: bm25_control(&docs, &query.text, RANKED),
+        truncated: true,
+    };
+    let lexical_hits: BTreeSet<EntityId> = {
+        let mut r = phase5::request(&input, 1024);
+        r.semantic = ChannelState::Unconfigured.into();
+        let run = build_context(&view, &view, &r, &baseline(), None).unwrap();
+        run.candidates
+            .entries
+            .iter()
+            .filter(|e| !e.channels.is_empty())
+            .map(|e| e.entity.clone())
+            .collect()
+    };
+    let unique = |hits: &[(EntityId, f64)]| {
+        let top: Vec<EntityId> = ids(hits).into_iter().take(DEPTH).collect();
+        top.iter()
+            .filter(|e| gold_set.contains(*e) && !lexical_hits.contains(*e))
+            .count()
+    };
+
+    let recall =
+        |run: &ContextRun| metrics(&all, &all_sources, run)["required_symbol_recall"].clone();
+    let mut rows = BTreeMap::new();
+    let mut packed_by: BTreeMap<&str, BTreeSet<EntityId>> = BTreeMap::new();
+    for (label, retrieval, channel) in configs(&semantic, &control) {
+        let mut config = baseline();
+        config.retrieval = retrieval;
+        let mut row = json!({});
+        for budget in BUDGETS {
+            let mut request = phase5::request(&input, budget);
+            request.semantic = channel.clone();
+            let t0 = Instant::now();
+            let run = build_context(&view, &view, &request, &config, None).unwrap();
+            let ms = t0.elapsed().as_secs_f64() * 1e3;
+            assert!(run.bundle.used_tokens <= budget);
+            row[format!("@{budget}")] = json!({
+                "required_symbol_recall": recall(&run),
+                "stages": stages(&run, &gold_symbols, &symbol_sources), "latency_ms": ms});
+            if budget == 1024 {
+                let entries: Vec<EntityId> = run
+                    .candidates
+                    .entries
+                    .iter()
+                    .map(|e| e.entity.clone())
+                    .collect();
+                let routed: BTreeSet<&EntityId> =
+                    run.route.candidates.iter().map(|c| &c.entity).collect();
+                let packed: BTreeSet<EntityId> = gold_symbols
+                    .iter()
+                    .zip(&symbol_sources)
+                    .filter(|(_, s)| {
+                        run.bundle
+                            .items
+                            .iter()
+                            .any(|i| common::covers(&i.source, s))
+                    })
+                    .map(|(g, _)| g.clone())
+                    .collect();
+                packed_by.insert(label, packed);
+                let work = run.route.trace.work;
+                row["entries"] = ranked(&entries, &gold_set);
+                row["entry_count"] = json!(entries.len());
+                row["routed_gold"] = json!(gold_set.iter().filter(|g| routed.contains(g)).count());
+                row["routed"] = json!(routed.len());
+                row["regions_loaded"] = json!(work.regions_loaded);
+                row["edges_examined"] = json!(work.edges_examined);
+                row["channels"] = json!(format!("{:?}", run.candidates.channels));
+                row["fusion_omitted"] = json!(run.candidates.fusion_omitted);
+            }
+        }
+        rows.insert(label, row);
+    }
+    // Gold packed at 1,024 with the channel that lexical alone misses.
+    let gained = |label: &str| {
+        let base = &packed_by["lexical"];
+        packed_by[label]
+            .iter()
+            .filter(|g| !base.contains(*g))
+            .count()
+    };
+    let lost = |label: &str| {
+        let with = &packed_by[label];
+        packed_by["lexical"]
+            .iter()
+            .filter(|g| !with.contains(*g))
+            .count()
+    };
+    let fused = ["lexical+semantic", "rrf", "lexical+control", "rrf-control"];
+    let deltas: BTreeMap<&str, Value> = fused
+        .iter()
+        .map(|l| {
+            (
+                *l,
+                json!({"packed_gold_gained": gained(l), "packed_gold_lost": lost(l)}),
+            )
+        })
+        .collect();
+    let out = json!({
+        "task": input.id, "repo": input.repository,
+        "gold_symbols": gold_set.len(),
+        "gold_symbols_embedded": gold_set.iter().filter(|g| embedded.contains(g)).count(),
+        "channel": {"semantic": ranked(&ids(&semantic.hits), &gold_set),
+                    "control": ranked(&ids(&control.hits), &gold_set),
+                    "unique_gold_at_20": {"semantic": unique(&semantic.hits), "control": unique(&control.hits)}},
+        "configs": rows, "packed_deltas_at_1024": deltas,
+        "cost": {"index_seconds": index_seconds, "documents": stats.documents,
+                 "unique_texts": stats.unique_texts, "cached": stats.cached, "embedded": stats.embedded,
+                 "seconds_embedding": stats.seconds_embedding,
+                 "query_ms_cold": cold_ms, "query_ms_warm": warm,
+                 "lexical_context_ms_during_build": during_build_ms,
+                 "degraded_during_build": degraded_during_build},
+        "space": format!("{space:?}"),
+        "peak_rss_kib": rss_peak_kib(),
+    });
+    drop(view);
+    drop(store);
+    let _ = std::fs::remove_dir_all(&dir);
+    out
+}
+
+fn endpoint() -> Endpoint {
+    Endpoint {
+        runner: Runner::LlamaCpp,
+        url: std::env::var("OXIDE_SEMANTIC_URL").unwrap_or_else(|_| "http://127.0.0.1:8091".into()),
+    }
+}
+
+fn dev_tasks(repos: &[String]) -> Vec<Value> {
+    let docs = repo_root().join("docs/phase-5/decisionbench-v1");
+    let read = |f: &str| -> Value {
+        serde_json::from_str(&std::fs::read_to_string(docs.join(f)).unwrap()).unwrap()
+    };
+    let splits: BTreeMap<String, Split> =
+        serde_json::from_value(read("splits.json")["repositories"].clone()).unwrap();
+    let spec = read("contextbench-tasks.json");
+    spec["tasks"]
+        .as_array()
+        .unwrap()
+        .iter()
+        // Dev only: calibration and test stay sealed.
+        .filter(|t| splits[t["repo"].as_str().unwrap()] == Split::Dev)
+        .filter(|t| repos.is_empty() || repos.iter().any(|r| r == t["repo"].as_str().unwrap()))
+        .cloned()
+        .collect()
+}
+
+/// Documents and bytes per repository, deduplicated across its tasks:
+/// what a cold cache would embed.
+fn estimate(tasks: &[Value]) {
+    let mut by_repo: BTreeMap<String, (BTreeSet<String>, usize)> = BTreeMap::new();
+    for t in tasks {
+        let indexed = phase5::index_task(t, &data_dir());
+        let view = indexed.store.open(&indexed.key).unwrap();
+        let docs = documents(&view, &indexed.symbols).unwrap();
+        let entry = by_repo
+            .entry(t["repo"].as_str().unwrap().into())
+            .or_default();
+        entry.1 += docs.len();
+        entry.0.extend(docs.into_iter().map(|(_, d)| d));
+        drop(view);
+        let _ = std::fs::remove_dir_all(&indexed.dir);
+        eprintln!("{} {}", t["id"], t["repo"]);
+    }
+    for (repo, (unique, total)) in &by_repo {
+        let bytes: usize = unique.iter().map(String::len).sum();
+        let hours = bytes as f64 * TOKENS_PER_BYTE / TOKENS_PER_SECOND / 3600.0;
+        eprintln!(
+            "{repo}: documents {total}, unique {}, est. hours {hours:.2}",
+            unique.len()
+        );
+    }
+}
+
+#[test]
+#[ignore = "machine-local: needs ContextBench worktrees and, for uncached vectors, a llama-server"]
+fn semantic_pilot() {
+    let name = std::env::var("OXIDE_SEMANTIC_SPACE").expect("set OXIDE_SEMANTIC_SPACE=lfm|eg2");
+    let space = space(&name);
+    let repos: Vec<String> = std::env::var("OXIDE_SEMANTIC_REPOS")
+        .map(|r| r.split(',').map(str::to_owned).collect())
+        .unwrap_or_default();
+    let tasks = dev_tasks(&repos);
+    if std::env::var_os("OXIDE_SEMANTIC_ESTIMATE").is_some() {
+        return estimate(&tasks);
+    }
+    if std::env::var_os("OXIDE_SEMANTIC_CALIBRATE").is_some() {
+        let probe = LlamaCpp::new(endpoint(), space.clone(), 16)
+            .probe(QUERY_TIMEOUT)
+            .unwrap();
+        eprintln!(
+            "served: {:?}\ncompare: {:?}",
+            probe.space,
+            space.compare(&probe.space)
+        );
+        return;
+    }
+    assert!(
+        !repos.is_empty(),
+        "name the pilot repositories in OXIDE_SEMANTIC_REPOS"
+    );
+    let cache: PathBuf = std::env::var_os("OXIDE_SEMANTIC_CACHE")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| {
+            let home = std::env::var_os("HOME").unwrap();
+            Path::new(&home).join("Projects/oxide-eval-data/oxide-semantic-eval/cache")
+        });
+    let results = data_dir().join("semantic-pilot").join(&name);
+    std::fs::create_dir_all(&results).unwrap();
+    let mut out = Vec::new();
+    for t in &tasks {
+        let id = t["id"].as_str().unwrap();
+        let path = results.join(format!("{id}.json"));
+        let fingerprint = format!("{space:?}");
+        let cached = std::fs::read_to_string(&path)
+            .ok()
+            .map(|text| serde_json::from_str::<Value>(&text).unwrap())
+            .filter(|r| r["space"] == fingerprint.as_str());
+        let r = cached.unwrap_or_else(|| {
+            let client = LlamaCpp::new(endpoint(), space.clone(), 16);
+            let r = measure(t, &space, client, &cache);
+            std::fs::write(&path, serde_json::to_string(&r).unwrap()).unwrap();
+            r
+        });
+        eprintln!("{id}");
+        out.push(r);
+    }
+    let summary = json!({"space": name, "repos": repos, "tasks": out});
+    let target = repo_root().join(format!("docs/semantic-eval/pilot-{name}.json"));
+    std::fs::create_dir_all(target.parent().unwrap()).unwrap();
+    std::fs::write(&target, common::canonical(&summary)).unwrap();
+}
