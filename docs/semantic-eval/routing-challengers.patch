+/// Checks semantic hits against the pinned generation and ranks them by
+/// score, then [`EntityId`]; keeps the first `depth`. Hits for another
+/// generation, non-finite scores or duplicate entities make the channel
+/// unavailable: they are never repaired into evidence.
+fn semantic_ranked(
+    snapshot: &SnapshotKey,
+    result: SemanticResult,
+    depth: usize,
+) -> Result<(Vec<(EntityId, ChannelEvidence)>, ChannelState), String> {
+    if result.snapshot != *snapshot {
+        return Err("semantic hits are for another generation".into());
+    }
+    let mut hits = result.hits;
+    if hits.iter().any(|(_, s)| !s.is_finite()) {
+        return Err("non-finite semantic score".into());
+    }
+    hits.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+    let mut seen = BTreeSet::new();
+    if !hits.iter().all(|(e, _)| seen.insert(e)) {
+        return Err("duplicate semantic hit".into());
+    }
+    let truncated = result.truncated || hits.len() > depth;
+    hits.truncate(depth);
+    let state = ChannelState::Ran {
+        scorer: result.scorer.clone(),
+        returned: hits.len(),
+        truncated,
+    };
+    let ranked = hits
+        .into_iter()
+        .enumerate()
+        .map(|(i, (entity, score))| {
+            let evidence = ChannelEvidence {
+                channel: Channel::Semantic,
+                rank: i as u32 + 1,
+                score,
+                scorer: result.scorer.clone(),
+            };
+            (entity, evidence)
+        })
+        .collect();
+    Ok((ranked, state))
+}
