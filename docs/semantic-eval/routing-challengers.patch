+        });
+    let results = data_dir().join("semantic-eval").join("tasks");
+    std::fs::create_dir_all(&results).unwrap();
+    let mut tasks = Vec::new();
+    for t in dev_tasks() {
+        let repo = t["repo"].as_str().unwrap();
+        if skip.iter().any(|r| r == repo) {
+            continue;
+        }
+        let id = t["id"].as_str().unwrap();
+        eprintln!("{id}");
+        let r = measure(&t, repos.iter().any(|r| r == repo), &cache);
+        std::fs::write(results.join(format!("{id}.json")), serde_json::to_string(&r).unwrap()).unwrap();
+        tasks.push(r);
+    }
+    let summary = json!({"space": format!("{:?}", space()), "semantic_repos": repos,
+                         "skipped_repos": skip, "tasks": tasks});
+    let target = repo_root().join("docs/semantic-eval/routing.json");
+    std::fs::write(&target, serde_json::to_string_pretty(&summary).unwrap() + "\n").unwrap();
+}
