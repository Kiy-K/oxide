+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Fusion {
+    /// Lexical entries, then the first `depth` semantic hits not already
+    /// entered, in semantic rank.
+    Append { depth: usize },
+    /// Weighted reciprocal-rank fusion of the lexical hits and the first
+    /// `depth` semantic hits: weight/(k + rank) summed per entity, weights
+    /// in thousandths; the best `keep` enter, ties by [`EntityId`].
+    Rrf {
+        k: u32,
+        lexical: u32,
+        semantic: u32,
+        depth: usize,
+        keep: usize,
+    },
+    /// Channels take turns by rank (lexical 1, semantic 1, lexical 2, ...)
+    /// over the first `depth` semantic hits; an entity already entered
+    /// keeps its first turn. The first `keep` entities enter.
+    Interleave { depth: usize, keep: usize },
+}
+
+impl Fusion {
+    /// Semantic hits the rule reads.
+    pub fn depth(self) -> usize {
+        match self {
+            Fusion::Append { depth } | Fusion::Rrf { depth, .. } | Fusion::Interleave { depth, .. } => depth,
+        }
+    }
+}
