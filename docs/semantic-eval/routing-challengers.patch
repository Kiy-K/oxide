+//! Experimental TreeRouter challenger (docs/semantic-eval/README.md):
+//! budgeted best-first exploration ordered by a local personalized
+//! PageRank estimate, under the baseline's limits and trace contract.
+//!
+//! - Personalization: every evidence lane present (structural seeds,
+//!   lexical, semantic) gets an equal share of mass, spread over its entry
+//!   points by `1 / (k + rank)`. Ranks only: channel scores never mix.
+//! - Exploration: the frontier region holding the most residual mass is
+//!   loaded next (ties by [`RegionId`]). Loading keeps `alpha` of its mass
+//!   and pushes the rest to its neighbors (the BFS expansion, cut to the
+//!   same fanout) in proportion to a relation weight. The divisor is the
+//!   weight of *all* its neighbors before the cut, so a high-degree hub
+//!   passes little mass to each; containing scopes and logical containment
+//!   weigh half. Mass reaching a loaded region is absorbed, never pushed
+//!   twice, so cycles end.
+//! - Loads, depth, fanout, edges and branch judgments are bounded and
+//!   traced exactly as in BFS; only the order differs. The router reads
+//!   nothing BFS would not (one region view per load, no graph preview).
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use crate::decision::{Allowance, DecisionPolicy, DecisionProvider, Subject};
+use crate::id::EntityId;
+use crate::knowledge::{Containment, RelationKind};
+use crate::retrieve::{Channel, EntryPoint};
+use crate::route::{
+    Bound, Candidate, Origin, RouteRequest, RouteResult, RouteStep, RouteWork, RoutingTrace, Visit,
+    expand, judge,
+};
+use crate::store::{MAX_REQUEST_ITEMS, ReadView, StoreError};
+use crate::tree::{NavLimits, RegionId, region};
+
+pub const PPR_ROUTER_VERSION: &str = "oxide-router-ppr-best-first-exp";
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Ppr {
+    /// Share of a loaded region's mass it keeps (restart probability).
+    pub alpha: f64,
+    /// Rank prior offset in `1 / (k + rank)`.
+    pub k: f64,
+}
+
+fn weight(origin: &Origin) -> f64 {
+    match origin {
+        Origin::Scope(_) => 0.5,
+        Origin::Neighbor {
+            relation: RelationKind::Contains(Containment::Logical),
+            ..
+        } => 0.5,
+        _ => 1.0,
+    }
+}
+
+/// Seed mass per entry point: equal per lane, `1 / (k + rank)` within one.
+fn personalization(entries: &[EntryPoint], k: f64) -> BTreeMap<RegionId, f64> {
+    let mut lanes: BTreeMap<u8, Vec<(RegionId, f64)>> = BTreeMap::new();
+    let mut seeded = 0u32;
+    for entry in entries {
+        let id = RegionId::of(entry.entity.clone());
+        if !entry.seeds.is_empty() {
+            seeded += 1;
+            lanes
+                .entry(0)
+                .or_default()
+                .push((id.clone(), 1.0 / (k + seeded as f64)));
+        }
+        for c in &entry.channels {
+            let lane = match c.channel {
+                Channel::Lexical => 1,
+                Channel::Semantic => 2,
+            };
+            lanes
+                .entry(lane)
+                .or_default()
+                .push((id.clone(), 1.0 / (k + c.rank as f64)));
+        }
+    }
+    let share = 1.0 / lanes.len().max(1) as f64;
+    let mut mass: BTreeMap<RegionId, f64> = BTreeMap::new();
+    for lane in lanes.values() {
+        let total: f64 = lane.iter().map(|(_, w)| w).sum();
+        for (id, w) in lane {
+            *mass.entry(id.clone()).or_default() += share * w / total;
+        }
+    }
+    mass
+}
+
+pub(crate) fn route(
+    view: &impl ReadView,
+    request: &RouteRequest,
+    ppr: Ppr,
+    mut provider: Option<&mut (dyn DecisionProvider + '_)>,
+    allowance: &mut Allowance,
+    decision_policy: DecisionPolicy,
+) -> Result<RouteResult, StoreError> {
+    let limits = request.limits;
+    // The whole neighbor list, for the hub-normalizing divisor; the
+    // frontier still gets the first `max_fanout`, as in BFS.
+    let nav = NavLimits {
+        children: MAX_REQUEST_ITEMS,
+        cross_edges: MAX_REQUEST_ITEMS,
+    };
+    let mut trace = RoutingTrace {
+        router: PPR_ROUTER_VERSION,
+        root_fallback: request.entry_points.is_empty(),
+        steps: Vec::new(),
+        decisions: Vec::new(),
+        truncations: Vec::new(),
+        stopped_by: None,
+        work: RouteWork::default(),
+    };
+    let mut entries: BTreeMap<&EntityId, &EntryPoint> = BTreeMap::new();
+    for entry in &request.entry_points {
+        entries.entry(&entry.entity).or_insert(entry);
+    }
+    let mut residual: BTreeMap<RegionId, f64> = if trace.root_fallback {
+        BTreeMap::from([(RegionId::root(), 1.0)])
+    } else {
+        personalization(&request.entry_points, ppr.k)
+    };
+    let origin0 = if trace.root_fallback {
+        Origin::RootFallback
+    } else {
+        Origin::EntryPoint
+    };
+    let mut depth: BTreeMap<RegionId, u32> = residual.keys().map(|id| (id.clone(), 0)).collect();
+    let mut reached: BTreeMap<RegionId, Vec<Origin>> = residual
+        .keys()
+        .map(|id| (id.clone(), vec![origin0.clone()]))
+        .collect();
+    let mut frontier: BTreeSet<RegionId> = residual.keys().cloned().collect();
+    let mut done: BTreeSet<RegionId> = BTreeSet::new();
+    let mut candidates: BTreeMap<EntityId, Candidate> = BTreeMap::new();
+
+    loop {
+        // Most residual mass first, ties by RegionId.
+        let Some(next) = frontier
+            .iter()
+            .max_by(|a, b| residual[*a].total_cmp(&residual[*b]).then_with(|| b.cmp(a)))
+            .cloned()
+        else {
+            break;
+        };
+        let bound = if trace.work.regions_loaded >= limits.max_regions {
+            Some(Bound::Regions)
+        } else if trace.work.edges_examined >= limits.max_edges {
+            Some(Bound::Edges)
+        } else {
+            None
+        };
+        if let Some(bound) = bound {
+            trace.stopped_by.get_or_insert(bound);
+            // Everything left is deferred, most promising first.
+            let mut left: Vec<RegionId> = std::mem::take(&mut frontier).into_iter().collect();
+            left.sort_by(|a, b| residual[b].total_cmp(&residual[a]).then_with(|| a.cmp(b)));
+            for id in left {
+                let d = depth[&id];
+                trace.steps.push(RouteStep {
+                    region: id,
+                    depth: d,
+                    visit: Visit::Deferred(bound),
+                });
+            }
+            break;
+        }
+        frontier.remove(&next);
+        done.insert(next.clone());
+        let d = depth[&next];
+        let region = region(view, &next, nav)?;
+        trace.work.regions_loaded += 1;
+        trace.work.edges_examined += region.children.len().min(limits.max_fanout)
+            + region.cross_edges.len().min(limits.max_fanout);
+
+        let origin = reached[&next][0].clone();
+        let loaded = [(region, origin)];
+        let cap = limits.max_judgments - trace.work.judgments_requested;
+        let (decisions, sent) = judge(
+            &request.snapshot,
+            &request.query,
+            &loaded,
+            provider.as_deref_mut(),
+            allowance,
+            cap,
+            decision_policy,
+        );
+        trace.work.judgments_requested += sent;
+        let [(region, _)] = loaded;
+        let mut pruned = false;
+        for decision in decisions {
+            if let (Subject::Region(_), None) = (&decision.subject, decision.fallback) {
+                pruned = decision.value < request.policy.prune_below;
+            }
+            trace.decisions.push(decision);
+        }
+        trace.steps.push(RouteStep {
+            region: next.clone(),
+            depth: d,
+            visit: if pruned {
+                Visit::Pruned
+            } else {
+                Visit::Explored
+            },
+        });
+        if pruned {
+            continue;
+        }
+        trace.work.max_depth_reached = trace.work.max_depth_reached.max(d);
+        let anchor = &region.id.anchor;
+        let entry = entries.get(anchor);
+        candidates.insert(
+            anchor.clone(),
+            Candidate {
+                entity: anchor.clone(),
+                depth: d,
+                origins: Vec::new(),
+                channels: entry.map_or_else(Vec::new, |e| e.channels.clone()),
+                seeds: entry.map_or_else(Vec::new, |e| e.seeds.clone()),
+            },
+        );
+
+        let mut neighbors = expand(&region, &request.policy);
+        trace.work.max_fanout_seen = trace.work.max_fanout_seen.max(neighbors.len());
+        let total: f64 = neighbors.iter().map(|(_, o)| weight(o)).sum();
+        if neighbors.len() > limits.max_fanout {
+            neighbors.truncate(limits.max_fanout);
+            trace.truncations.push((region.id.clone(), Bound::Fanout));
+        }
+        let spread = (1.0 - ppr.alpha) * residual[&next];
+        for (id, origin) in neighbors {
+            let origins = reached.entry(id.clone()).or_default();
+            if !origins.contains(&origin) {
+                origins.push(origin.clone());
+            }
+            // Depth is the shortest path seen so far: best-first can reach
+            // a region late by a shorter path than its first one.
+            let known = depth.get(&id).copied();
+            if known.is_some() {
+                trace.work.revisits += 1;
+            }
+            if !done.contains(&id) {
+                *residual.entry(id.clone()).or_default() += spread * weight(&origin) / total;
+            }
+            if known.is_some_and(|k| k <= d + 1) {
+                continue;
+            }
+            depth.insert(id.clone(), d + 1);
+            if done.contains(&id) || frontier.contains(&id) {
+                continue;
+            }
+            if d as usize >= limits.max_depth {
+                trace.stopped_by.get_or_insert(Bound::Depth);
+                trace.steps.push(RouteStep {
+                    region: id,
+                    depth: d + 1,
+                    visit: Visit::Deferred(Bound::Depth),
+                });
+                continue;
+            }
+            trace.work.edges_followed += 1;
+            frontier.insert(id);
+        }
+    }
+
+    for candidate in candidates.values_mut() {
+        let id = RegionId::of(candidate.entity.clone());
+        candidate.origins = reached.get(&id).cloned().unwrap_or_default();
+    }
+    Ok(RouteResult {
+        snapshot: request.snapshot.clone(),
+        candidates: candidates.into_values().collect(),
+        trace,
+    })
+}
