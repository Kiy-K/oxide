+#[cfg(test)]
+mod tests {
+    use std::sync::Mutex;
+    use std::sync::mpsc::{Receiver, Sender, channel};
+
+    use oxide_kernel::id::{DerivationId, RepoId, RepoPath, Segment, SnapshotId, SymbolId};
+
+    use super::*;
+    use crate::embedding::{Endpoint, Metric, Probe, Runner};
+
+    const SECOND: Duration = Duration::from_secs(1);
+
+    fn space() -> EmbeddingSpace {
+        EmbeddingSpace {
+            runner: Runner::LlamaCpp,
+            model: "fake".into(),
+            model_digest: Some("sha256:aaa".into()),
+            quantization: Some("q4".into()),
+            dimension: 2,
+            metric: Metric::Cosine,
+            normalized: Some(true),
+            pooling: Some("cls".into()),
+            tokenizer: Some("t".into()),
+            query_prompt: Some("query: ".into()),
+            document_prompt: Some("document: ".into()),
+            document_recipe: recipe::SEMANTIC_RECIPE.into(),
+            runner_version: Some("b1".into()),
+            max_tokens: Some(512),
+            canary: Some(vec![1]),
+        }
+    }
+
+    fn key() -> SnapshotKey {
+        SnapshotKey {
+            repo: RepoId::new("r").unwrap(),
+            snapshot: SnapshotId::new("s1").unwrap(),
+            derivation: DerivationId::new("d1").unwrap(),
+        }
+    }
+
+    fn sym(name: &str) -> EntityId {
+        let path = vec![Segment {
+            name: name.into(),
+            ordinal: 0,
+        }];
+        EntityId::Symbol(SymbolId::new(RepoPath::new("a.py").unwrap(), path).unwrap())
+    }
+
+    /// Texts mentioning "x" point along x, others along y; one vector per
+    /// call is counted. With `gate`, every batch waits for a permit.
+    struct Fake {
+        space: EmbeddingSpace,
+        served: Arc<Mutex<String>>,
+        calls: Arc<AtomicUsize>,
+        gate: Option<Mutex<Receiver<()>>>,
+        endpoint: Endpoint,
+    }
+
+    fn fake(served: &Arc<Mutex<String>>, calls: &Arc<AtomicUsize>) -> Fake {
+        Fake {
+            space: space(),
+            served: served.clone(),
+            calls: calls.clone(),
+            gate: None,
+            endpoint: Endpoint {
+                runner: Runner::LlamaCpp,
+                url: "http://127.0.0.1:1".into(),
+            },
+        }
+    }
+
+    impl EmbeddingProvider for Fake {
+        fn endpoint(&self) -> &Endpoint {
+            &self.endpoint
+        }
+        fn probe(&self, _: Duration) -> Result<Probe, EmbedError> {
+            Ok(Probe {
+                space: self.space.clone(),
+                max_batch: 2,
+            })
+        }
+        fn embed(&self, texts: &[String], _: Duration) -> Result<Vec<Vec<f32>>, EmbedError> {
+            if let Some(gate) = &self.gate {
+                gate.lock().unwrap().recv().unwrap();
+            }
+            self.calls.fetch_add(texts.len(), Ordering::Relaxed);
+            let along = |t: &String| match t.contains('x') {
+                true => vec![1.0, 0.0],
+                false => vec![0.0, 1.0],
+            };
+            Ok(texts.iter().map(along).collect())
+        }
+        fn served(&self, _: Duration) -> Result<Option<String>, EmbedError> {
+            Ok(Some(self.served.lock().unwrap().clone()))
+        }
+    }
+
+    fn docs() -> Vec<(EntityId, String)> {
+        ["bx", "ax", "cy", "dy"]
+            .iter()
+            .map(|n| (sym(n), format!("a.py\n{n}")))
+            .collect()
+    }
+
+    fn build(provider: Fake, root: &Path) -> Result<(SemanticIndex, BuildStats), String> {
+        let docs = docs();
+        Build::spawn(
+            Box::new(provider),
+            space(),
+            root.into(),
+            key(),
+            docs,
+            SECOND,
+        )
+        .join()
+    }
+
+    fn scratch(name: &str) -> PathBuf {
+        let dir =
+            std::env::temp_dir().join(format!("oxide-semantic-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        dir
+    }
+
+    #[test]
+    fn builds_reuse_the_cache_and_search_is_exact_and_deterministic() {
+        let root = scratch("reuse");
+        let served = Arc::new(Mutex::new("m1|b1".to_owned()));
+        let calls = Arc::new(AtomicUsize::new(0));
+        let (index, stats) = build(fake(&served, &calls), &root).unwrap();
+        assert_eq!((stats.embedded, stats.cached, index.len()), (4, 0, 4));
+        // A second build of the same documents embeds nothing.
+        let (index, stats) = build(fake(&served, &calls), &root).unwrap();
+        assert_eq!((stats.embedded, stats.cached), (0, 4));
+        assert_eq!(calls.load(Ordering::Relaxed), 4);
+
+        let provider = fake(&served, &calls);
+        let query = Query { text: "x".into() };
+        let result = index.search(&provider, &query, 3, SECOND).unwrap();
+        // Equal scores rank by EntityId; the cut is reported.
+        let ids: Vec<EntityId> = result.hits.iter().map(|(e, _)| e.clone()).collect();
+        assert_eq!(ids, [sym("ax"), sym("bx"), sym("cy")]);
+        assert!(result.truncated);
+        assert_eq!(result.snapshot, key());
+
+        // A model swapped behind the endpoint is refused, not compared.
+        *served.lock().unwrap() = "m2|b1".into();
+        let fusion = Fusion::Append { depth: 2 };
+        assert!(matches!(
+            index.channel(&provider, &query, fusion, SECOND),
+            Semantic::Absent(ChannelState::Unavailable(_))
+        ));
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    #[test]
+    fn a_torn_record_is_dropped_and_other_spaces_never_share_vectors() {
+        let root = scratch("torn");
+        let served = Arc::new(Mutex::new("m1|b1".to_owned()));
+        let calls = Arc::new(AtomicUsize::new(0));
+        build(fake(&served, &calls), &root).unwrap();
+        let cache = VectorCache::open(&root, &space()).unwrap();
+        assert_eq!(cache.len(), 4);
+        drop(cache);
+        let dir = std::fs::read_dir(&root)
+            .unwrap()
+            .next()
+            .unwrap()
+            .unwrap()
+            .path();
+        let file = OpenOptions::new()
+            .append(true)
+            .open(dir.join("vectors.bin"))
+            .unwrap();
+        file.set_len(file.metadata().unwrap().len() - 3).unwrap();
+        drop(file);
+        assert_eq!(VectorCache::open(&root, &space()).unwrap().len(), 3);
+
+        let other = EmbeddingSpace {
+            runner_version: Some("b2".into()),
+            ..space()
+        };
+        assert!(VectorCache::open(&root, &other).unwrap().is_empty());
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    #[test]
+    fn builds_run_in_the_background_cancel_and_keep_their_progress() {
+        let root = scratch("cancel");
+        let served = Arc::new(Mutex::new("m1|b1".to_owned()));
+        let calls = Arc::new(AtomicUsize::new(0));
+        let (permit, gate): (Sender<()>, Receiver<()>) = channel();
+        let provider = Fake {
+            gate: Some(Mutex::new(gate)),
+            ..fake(&served, &calls)
+        };
+        let docs: Vec<(EntityId, String)> = ["ax", "bx", "cy", "dy", "ex", "fy"]
+            .iter()
+            .map(|n| (sym(n), format!("a.py\n{n}")))
+            .collect();
+        let build = Build::spawn(
+            Box::new(provider),
+            space(),
+            root.clone(),
+            key(),
+            docs,
+            SECOND,
+        );
+        permit.send(()).unwrap();
+        let started = Instant::now();
+        while build.progress() != (2, 6) {
+            assert!(started.elapsed() < 10 * SECOND, "first batch never landed");
+            std::thread::yield_now();
+        }
+        assert!(!build.is_finished());
+        assert_eq!(
+            build.pending(),
+            ChannelState::Unavailable("vectors building 2/6".into())
+        );
+        build.cancel();
+        // The batch already waiting finishes; the third never starts.
+        permit.send(()).unwrap();
+        let error = build.join().err().unwrap();
+        assert!(error.contains("Cancelled"), "{error}");
+        drop(permit);
+        assert_eq!(VectorCache::open(&root, &space()).unwrap().len(), 4);
+
+        // A runner serving another space is refused before any embedding.
+        let mut drifted = fake(&served, &calls);
+        drifted.space.canary = Some(vec![999]);
+        let before = calls.load(Ordering::Relaxed);
+        assert!(build_with(drifted, &root).is_err());
+        assert_eq!(calls.load(Ordering::Relaxed), before);
+        let _ = std::fs::remove_dir_all(&root);
+    }
+
+    fn build_with(provider: Fake, root: &Path) -> Result<(SemanticIndex, BuildStats), String> {
+        build(provider, root)
+    }
+}
