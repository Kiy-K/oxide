+//! Semantic evidence and graph-aware routing end to end
+//! (docs/semantic-eval/README.md, preregistration.md): lexical only,
+//! semantic only, hybrid under the existing policy, hybrid with
+//! channel-aware fusion and judging, a body-text BM25 control, and the
+//! experimental PPR best-first router against BFS, all through the real
+//! pipeline (routing, selection, packing) with the same candidate and work
+//! budgets. Dev split only. Opt-in and machine-local; it never calls JEV.
+//!
+//! Lexical configurations run on every dev task. Semantic ones run on the
+//! repositories in `OXIDE_SEMANTIC_REPOS`: a task's first run builds its
+//! vectors from the persistent cache (embedding what the cache lacks on a
+//! capped llama-server) and records the query's ranked hits; later runs
+//! replay them and need no runner:
+//!
+//! ```text
+//! OXIDE_CB_WORKTREES=<dir>:<dir> OXIDE_SEMANTIC_REPOS=sphinx-doc/sphinx \
+//!   OXIDE_SEMANTIC_CANARY_LFM=<pinned> [OXIDE_SEMANTIC_URL=http://127.0.0.1:8091] \
+//!   cargo test --release -p oxide-runtime --test semantic_routing -- --ignored --nocapture
+//! ```
+
+mod common;
+
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use common::phase5::{self, Indexed, TaskInput, data_dir, stages};
+use common::{gold_sources, metrics, repo_root, rss_peak_kib};
+use oxide_kernel::capsule::{Capsule, Question};
+use oxide_kernel::context::{ContextConfig, ContextRun, baseline, build_context};
+use oxide_kernel::decision::{
+    Allowance, DecisionProvider, Heuristic, Judgment, ProviderError, ProviderIdentity, Verdict,
+};
+use oxide_kernel::id::EntityId;
+use oxide_kernel::lexical::terms;
+use oxide_kernel::ppr::Ppr;
+use oxide_kernel::query::Query;
+use oxide_kernel::retrieve::{
+    BASELINE, Channel, ChannelState, Fusion, RetrievalConfig, Semantic, retrieve,
+};
+use oxide_kernel::route::{RouteRequest, Strategy, Visit, route};
+use oxide_kernel::semantic::{self as recipe, SemanticResult};
+use oxide_kernel::store::KnowledgeStore;
+use oxide_runtime::decisionbench::Split;
+use oxide_runtime::embedding::{EmbeddingSpace, Endpoint, LlamaCpp, Metric, Runner};
+use oxide_runtime::semantic::{Build, documents};
+use serde_json::{Value, json};
+
+const BUDGETS: [u32; 3] = [256, 1024, 4096];
+/// Semantic hits every fused configuration reads: the lexical limit.
+const DEPTH: usize = 20;
+/// Hits kept per task for channel-only Recall@K and MRR.
+const RANKED: usize = 100;
+const QUERY_TIMEOUT: Duration = Duration::from_secs(30);
+const BATCH_TIMEOUT: Duration = Duration::from_secs(300);
+/// Preregistered PPR parameters: the usual restart probability, and the
+/// frozen RRF constant or a top-heavy prior.
+const PPR_FLAT: Ppr = Ppr { alpha: 0.15, k: 60.0 };
+const PPR_TOP: Ppr = Ppr { alpha: 0.15, k: 1.0 };
+
+/// LiquidAI/LFM2.5-Embedding-350M-GGUF Q4_K_M (LFM Open License v1.0):
+/// explicit identity, never discovered.
+fn space() -> EmbeddingSpace {
+    let canary = std::env::var("OXIDE_SEMANTIC_CANARY_LFM")
+        .ok()
+        .map(|text| text.split(',').map(|x| x.trim().parse().unwrap()).collect());
+    EmbeddingSpace {
+        runner: Runner::LlamaCpp,
+        model: "LFM2.5-Embedding-350M".into(),
+        model_digest: Some(
+            "sha256:4d7aa9dc6406a10fc3dec2c11f8f06781af063bf49211b8e4132e9b876d3f32a".into(),
+        ),
+        quantization: Some("Q4_K - Medium".into()),
+        dimension: 1024,
+        metric: Metric::Cosine,
+        normalized: Some(true),
+        pooling: Some("cls".into()),
+        tokenizer: Some("lfm2".into()),
+        query_prompt: Some("query: ".into()),
+        document_prompt: Some("document: ".into()),
+        document_recipe: recipe::SEMANTIC_RECIPE.into(),
+        runner_version: Some("b11540-1e6f04a75".into()),
+        max_tokens: Some(512),
+        canary,
+    }
+}
+
+/// Candidate channel-aware relevance prior: an entry point from any scored
+/// channel gets the heuristic's lexical rank prior at its best rank in any
+/// channel (ranks only: channel scores are never compared). Everything
+/// else is the heuristic's, so lexical-only runs are unchanged.
+struct Channels;
+
+impl Channels {
+    fn value(c: &Capsule) -> f64 {
+        let relevance = matches!(c.question, Question::Relevance | Question::Necessity);
+        let container = matches!(c.kind.as_str(), "repository" | "module" | "file");
+        match c.channels.iter().map(|e| e.rank).min() {
+            Some(best) if relevance && !container && c.seeds.is_empty() => {
+                (0.85 - 0.025 * best.saturating_sub(1) as f64).max(0.5)
+            }
+            _ => Heuristic::value(c),
+        }
+    }
+}
+
+impl DecisionProvider for Channels {
+    fn identity(&self) -> ProviderIdentity {
+        ProviderIdentity {
+            name: "heuristic-channels".into(),
+            version: "candidate".into(),
+        }
+    }
+
+    fn supports(&self, _: Question) -> bool {
+        true
+    }
+
+    fn judge(&mut self, capsules: &[Capsule]) -> Result<Vec<Judgment>, ProviderError> {
+        Ok(capsules
+            .iter()
+            .map(|c| {
+                let value = Self::value(c);
+                Judgment::of(c, Verdict::Value { value, confidence: None })
+            })
+            .collect())
+    }
+}
+
+/// BM25 over the same documents the model embeds, with OXIDE's lexical
+/// terms and the production FTS parameters: the control for "the channel
+/// sees symbol bodies", separating that from what the model adds.
+fn bm25_control(docs: &[(EntityId, String)], query: &str, depth: usize) -> Vec<(EntityId, f64)> {
+    let (k1, b) = (1.2, 0.75);
+    let bags: Vec<HashMap<String, f64>> = docs
+        .iter()
+        .map(|(_, d)| {
+            let mut bag = HashMap::new();
+            terms(d)
+                .into_iter()
+                .for_each(|t| *bag.entry(t).or_default() += 1.0);
+            bag
+        })
+        .collect();
+    let lengths: Vec<f64> = bags.iter().map(|b| b.values().sum()).collect();
+    let average = lengths.iter().sum::<f64>() / lengths.len().max(1) as f64;
+    let wanted: BTreeSet<String> = terms(recipe::query(query)).into_iter().collect();
+    let n = docs.len() as f64;
+    let idf: HashMap<&String, f64> = wanted
+        .iter()
+        .map(|t| {
+            let df = bags.iter().filter(|b| b.contains_key(t)).count() as f64;
+            (t, (1.0 + (n - df + 0.5) / (df + 0.5)).ln())
+        })
+        .collect();
+    let mut scored: Vec<(EntityId, f64)> = bags
+        .iter()
+        .zip(&lengths)
+        .zip(docs)
+        .filter_map(|((bag, len), (id, _))| {
+            let s: f64 = wanted
+                .iter()
+                .filter_map(|t| {
+                    let f = *bag.get(t)?;
+                    Some(idf[t] * f * (k1 + 1.0) / (f + k1 * (1.0 - b + b * len / average)))
+                })
+                .sum();
+            (s > 0.0).then(|| (id.clone(), s))
+        })
+        .collect();
+    scored.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
+    scored.truncate(depth);
+    scored
+}
+
+/// Recall@K and MRR of `gold` in a ranked list.
+fn ranked(list: &[EntityId], gold: &BTreeSet<EntityId>) -> Value {
+    let at = |k: usize| list.iter().take(k).filter(|e| gold.contains(e)).count() as f64;
+    let n = gold.len().max(1) as f64;
+    let first = list.iter().position(|e| gold.contains(e));
+    json!({"r10": at(10) / n, "r20": at(20) / n, "r40": at(40) / n, "r100": at(100) / n,
+           "mrr": first.map_or(0.0, |p| 1.0 / (p + 1) as f64), "gold": gold.len()})
+}
+
+fn ids(hits: &[(EntityId, f64)]) -> Vec<EntityId> {
+    hits.iter().map(|(e, _)| e.clone()).collect()
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Lane {
+    None,
+    Semantic,
+    Control,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Judge {
+    Heuristic,
+    Channels,
+    Fill,
+}
+
+/// Post-hoc diagnostic, not preregistered: a semantic-only entry point is
+/// valued below every lexical one but above the include floor (0.45 at
+/// rank 1, down to 0.41), so it can only use budget lexical evidence
+/// leaves; the rest is the heuristic's.
+struct Fill;
+
+impl DecisionProvider for Fill {
+    fn identity(&self) -> ProviderIdentity {
+        ProviderIdentity {
+            name: "heuristic-fill".into(),
+            version: "diagnostic".into(),
+        }
+    }
+
+    fn supports(&self, _: Question) -> bool {
+        true
+    }
+
+    fn judge(&mut self, capsules: &[Capsule]) -> Result<Vec<Judgment>, ProviderError> {
+        Ok(capsules
+            .iter()
+            .map(|c| {
+                let relevance = matches!(c.question, Question::Relevance | Question::Necessity);
+                let container = matches!(c.kind.as_str(), "repository" | "module" | "file");
+                let lexical = c.channels.iter().any(|e| e.channel == Channel::Lexical);
+                let semantic = c.channels.iter().find(|e| e.channel == Channel::Semantic);
+                let value = match semantic {
+                    Some(e) if relevance && !container && !lexical && c.seeds.is_empty() => {
+                        (0.45 - 0.0025 * e.rank.saturating_sub(1) as f64).max(0.41)
+                    }
+                    _ => Heuristic::value(c),
+                };
+                Judgment::of(c, Verdict::Value { value, confidence: None })
+            })
+            .collect())
+    }
+}
+
+struct Config {
+    label: &'static str,
+    lexical: bool,
+    lane: Lane,
+    fusion: Fusion,
+    judge: Judge,
+    strategy: Strategy,
+}
+
+fn configs() -> Vec<Config> {
+    let append = Fusion::Append { depth: DEPTH };
+    let all = Fusion::Interleave {
+        depth: DEPTH,
+        keep: 2 * DEPTH,
+    };
+    let equal = Fusion::Interleave {
+        depth: DEPTH,
+        keep: DEPTH,
+    };
+    let rrf = Fusion::Rrf {
+        k: 60,
+        lexical: 600,
+        semantic: 400,
+        depth: DEPTH,
+        keep: DEPTH,
+    };
+    let bfs = Strategy::Bfs;
+    let flat = Strategy::Ppr(PPR_FLAT);
+    let top = Strategy::Ppr(PPR_TOP);
+    let c = |label, lexical, lane, fusion, judge, strategy| Config {
+        label,
+        lexical,
+        lane,
+        fusion,
+        judge,
+        strategy,
+    };
+    use Judge::*;
+    use Lane::*;
+    vec![
+        c("lexical", true, None, append, Heuristic, bfs),
+        c("lexical/ch", true, None, append, Channels, bfs),
+        c("lexical/ppr60", true, None, append, Heuristic, flat),
+        c("lexical/ppr1", true, None, append, Heuristic, top),
+        c("semantic", false, Semantic, append, Heuristic, bfs),
+        c("semantic/ch", false, Semantic, append, Channels, bfs),
+        c("append", true, Semantic, append, Heuristic, bfs),
+        c("append/ch", true, Semantic, append, Channels, bfs),
+        c("interleave40/ch", true, Semantic, all, Channels, bfs),
+        c("interleave20/ch", true, Semantic, equal, Channels, bfs),
+        c("rrf20", true, Semantic, rrf, Heuristic, bfs),
+        c("rrf20/ch", true, Semantic, rrf, Channels, bfs),
+        c("interleave40/ch/ppr60", true, Semantic, all, Channels, flat),
+        c("interleave40/ch/ppr1", true, Semantic, all, Channels, top),
+        c("interleave40/fill", true, Semantic, all, Fill, bfs),
+        c("interleave40-control/fill", true, Control, all, Fill, bfs),
+        c("control/ch", false, Control, append, Channels, bfs),
+        c("append-control", true, Control, append, Heuristic, bfs),
+        c("interleave40-control/ch", true, Control, all, Channels, bfs),
+    ]
+}
+
+/// One task's ranked semantic hits (top [`RANKED`]) and what producing them
+/// cost, recorded on its first run so later runs replay them: entity
+/// `Debug` text and the score's f32 bits (scores are f32 cosines).
+fn semantic_hits(
+    t: &Value,
+    indexed: &Indexed,
+    docs: &[(EntityId, String)],
+    query: &Query,
+    cache: &Path,
+) -> (SemanticResult, Value) {
+    let space = space();
+    let id = t["id"].as_str().unwrap();
+    let dir = data_dir().join("semantic-eval");
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join(format!("{id}.json"));
+    let fingerprint = format!("{space:?}");
+    let by_text: HashMap<String, &EntityId> =
+        docs.iter().map(|(e, _)| (format!("{e:?}"), e)).collect();
+    let replay = |r: &Value| SemanticResult {
+        snapshot: indexed.key.clone(),
+        scorer: r["scorer"].as_str().unwrap().into(),
+        hits: r["hits"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|h| {
+                let entity = by_text[h[0].as_str().unwrap()].clone();
+                (entity, f32::from_bits(h[1].as_u64().unwrap() as u32) as f64)
+            })
+            .collect(),
+        truncated: r["truncated"].as_bool().unwrap(),
+    };
+    if let Ok(text) = std::fs::read_to_string(&path) {
+        let r: Value = serde_json::from_str(&text).unwrap();
+        if r["space"] == fingerprint.as_str() && r["query"] == query.text.as_str() {
+            return (replay(&r), r["cost"].clone());
+        }
+    }
+    let endpoint = Endpoint {
+        runner: Runner::LlamaCpp,
+        url: std::env::var("OXIDE_SEMANTIC_URL")
+            .unwrap_or_else(|_| "http://127.0.0.1:8091".into()),
+    };
+    let client = || LlamaCpp::new(endpoint.clone(), space.clone(), 16);
+    let build = Build::spawn(
+        Box::new(client()),
+        space.clone(),
+        cache.into(),
+        indexed.key.clone(),
+        docs.to_vec(),
+        BATCH_TIMEOUT,
+    );
+    let mut last = Instant::now();
+    while !build.is_finished() {
+        std::thread::sleep(Duration::from_millis(200));
+        if last.elapsed() > Duration::from_secs(30) {
+            eprintln!("  {id} vectors {:?}", build.progress());
+            last = Instant::now();
+        }
+    }
+    let (index, stats) = build.join().unwrap_or_else(|e| panic!("{id}: build: {e}"));
+    let client = client();
+    let timed = || {
+        let t0 = Instant::now();
+        let r = index.search(&client, query, RANKED, QUERY_TIMEOUT).unwrap();
+        (r, t0.elapsed().as_secs_f64() * 1e3)
+    };
+    let (result, first_ms) = timed();
+    let warm: Vec<f64> = (0..3).map(|_| timed().1).collect();
+    let cost = json!({"documents": stats.documents, "unique_texts": stats.unique_texts,
+                      "cached": stats.cached, "embedded": stats.embedded,
+                      "seconds_embedding": stats.seconds_embedding,
+                      "vectors_mib": (index.len() * 4 * space.dimension as usize) as f64 / 1048576.0,
+                      "query_ms_first": first_ms, "query_ms_warm": warm});
+    let hits: Vec<Value> = result
+        .hits
+        .iter()
+        .map(|(e, s)| json!([format!("{e:?}"), (*s as f32).to_bits()]))
+        .collect();
+    let record = json!({"space": fingerprint, "query": query.text, "scorer": result.scorer,
+                        "truncated": result.truncated, "cost": cost, "hits": hits});
+    std::fs::write(&path, serde_json::to_string_pretty(&record).unwrap() + "\n").unwrap();
+    // Replayed, so the first run ranks exactly like every later one.
+    (replay(&record), cost)
+}
+
+/// Retrieval and routing alone, timed: router CPU time and its frontier.
+fn route_cost(view: &impl oxide_kernel::store::ReadView, request: &oxide_kernel::context::ContextRequest, config: &ContextConfig) -> Value {
+    let t0 = Instant::now();
+    let set = retrieve(view, &request.query, &request.context, request.semantic.clone(), config.retrieval).unwrap();
+    let retrieve_ms = t0.elapsed().as_secs_f64() * 1e3;
+    let route_request = RouteRequest {
+        snapshot: set.snapshot.clone(),
+        query: request.query.clone(),
+        entry_points: set.entries.clone(),
+        limits: config.route_limits,
+        policy: config.route_policy.clone(),
+    };
+    let mut allowance = Allowance { remaining: config.judgments };
+    let t0 = Instant::now();
+    let routed = route(view, &route_request, None, &mut allowance, config.decision).unwrap();
+    let route_ms = t0.elapsed().as_secs_f64() * 1e3;
+    let w = routed.trace.work;
+    let deferred = routed.trace.steps.iter().filter(|s| matches!(s.visit, Visit::Deferred(_))).count();
+    let pruned = routed.trace.steps.iter().filter(|s| s.visit == Visit::Pruned).count();
+    json!({"retrieve_ms": retrieve_ms, "route_ms": route_ms,
+           "regions_loaded": w.regions_loaded, "adjacency_reads": w.regions_loaded,
+           "graph_preview_reads": 0, "edges_examined": w.edges_examined,
+           "edges_followed": w.edges_followed, "revisits": w.revisits,
+           "max_depth_reached": w.max_depth_reached, "deferred": deferred, "pruned": pruned,
+           "frontier_regions": routed.trace.steps.len(), "stopped_by": format!("{:?}", routed.trace.stopped_by)})
+}
+
+fn measure(t: &Value, semantic_repo: bool, cache: &Path) -> Value {
+    let indexed = phase5::index_task(t, &data_dir());
+    let view = indexed.store.open(&indexed.key).unwrap();
+    let query = Query {
+        text: t["query"].as_str().unwrap().into(),
+    };
+    let gold = indexed.gold.clone();
+    let input = TaskInput {
+        id: t["id"].as_str().unwrap(),
+        repository: t["repo"].as_str().unwrap(),
+        split: Split::Dev,
+        query: &query.text,
+        symbols: Vec::new(),
+        gold: gold.clone(),
+    };
+    let all: Vec<EntityId> = gold.verified.iter().cloned().collect();
+    let all_sources = gold_sources(&view, &all);
+    let gold_symbols: Vec<EntityId> = all
+        .iter()
+        .filter(|g| matches!(g, EntityId::Symbol(_)))
+        .cloned()
+        .collect();
+    let symbol_sources = gold_sources(&view, &gold_symbols);
+    let gold_set: BTreeSet<EntityId> = gold_symbols.iter().cloned().collect();
+
+    let mut out = json!({"task": input.id, "repo": input.repository,
+                         "gold": all.len(), "gold_symbols": gold_set.len()});
+    let mut lanes: Option<(SemanticResult, SemanticResult)> = None;
+    if semantic_repo {
+        let started = Instant::now();
+        let docs = documents(&view, &indexed.symbols).unwrap();
+        let documents_ms = started.elapsed().as_secs_f64() * 1e3;
+        let embedded: BTreeSet<&EntityId> = docs.iter().map(|(e, _)| e).collect();
+        let (semantic, cost) = semantic_hits(t, &indexed, &docs, &query, cache);
+        let started = Instant::now();
+        let control = SemanticResult {
+            snapshot: indexed.key.clone(),
+            scorer: "control:bm25-body;oxide-terms;k1=1.2;b=0.75".into(),
+            hits: bm25_control(&docs, &query.text, RANKED),
+            truncated: true,
+        };
+        let control_ms = started.elapsed().as_secs_f64() * 1e3;
+        let lexical_hits: BTreeSet<EntityId> = {
+            let request = phase5::request(&input, 1024);
+            let run = build_context(&view, &view, &request, &baseline(), None).unwrap();
+            run.candidates.entries.iter().map(|e| e.entity.clone()).collect()
+        };
+        let unique = |hits: &[(EntityId, f64)]| {
+            let top = ids(hits).into_iter().take(DEPTH);
+            top.filter(|e| gold_set.contains(e) && !lexical_hits.contains(e)).count()
+        };
+        out["gold_symbols_embedded"] = json!(gold_set.iter().filter(|g| embedded.contains(g)).count());
+        out["channel"] = json!({"semantic": ranked(&ids(&semantic.hits), &gold_set),
+            "control": ranked(&ids(&control.hits), &gold_set),
+            "unique_gold_at_20": {"semantic": unique(&semantic.hits), "control": unique(&control.hits)}});
+        out["semantic_cost"] = json!({"documents_ms": documents_ms, "control_ms": control_ms, "channel": cost});
+        lanes = Some((semantic, control));
+    }
+
+    let mut rows = BTreeMap::new();
+    let mut packed_by: BTreeMap<&str, BTreeSet<EntityId>> = BTreeMap::new();
+    for c in configs() {
+        let channel: Semantic = match (c.lane, &lanes) {
+            (Lane::None, _) => ChannelState::Unconfigured.into(),
+            (_, None) => continue,
+            (Lane::Semantic, Some((s, _))) => Semantic::Ran { result: s.clone(), fusion: c.fusion },
+            (Lane::Control, Some((_, k))) => Semantic::Ran { result: k.clone(), fusion: c.fusion },
+        };
+        let mut config = baseline();
+        config.retrieval = RetrievalConfig { lexical: c.lexical, ..BASELINE };
+        config.route_policy.strategy = c.strategy;
+        let mut row = json!({});
+        for budget in BUDGETS {
+            let mut request = phase5::request(&input, budget);
+            request.semantic = channel.clone();
+            let (mut channels, mut fill) = (Channels, Fill);
+            let provider: Option<&mut dyn DecisionProvider> = match c.judge {
+                Judge::Heuristic => None,
+                Judge::Channels => Some(&mut channels),
+                Judge::Fill => Some(&mut fill),
+            };
+            let t0 = Instant::now();
+            let run: ContextRun = build_context(&view, &view, &request, &config, provider).unwrap();
+            let ms = t0.elapsed().as_secs_f64() * 1e3;
+            assert!(run.bundle.used_tokens <= budget);
+            let m = metrics(&all, &all_sources, &run);
+            let keep = ["required_symbol_recall", "routed_gold_coverage", "selection_loss", "packing_loss"];
+            let mut cell: serde_json::Map<String, Value> =
+                keep.iter().map(|k| (k.to_string(), m[*k].clone())).collect();
+            cell.insert("stages".into(), stages(&run, &gold_symbols, &symbol_sources));
+            cell.insert("latency_ms".into(), json!(ms));
+            row[format!("@{budget}")] = Value::Object(cell);
+            if budget == 1024 {
+                let entries: Vec<EntityId> = run.candidates.entries.iter().map(|e| e.entity.clone()).collect();
+                let packed: BTreeSet<EntityId> = gold_symbols
+                    .iter()
+                    .zip(&symbol_sources)
+                    .filter(|(_, s)| run.bundle.items.iter().any(|i| common::covers(&i.source, s)))
+                    .map(|(g, _)| g.clone())
+                    .collect();
+                packed_by.insert(c.label, packed);
+                row["entries"] = ranked(&entries, &gold_set);
+                row["entry_count"] = json!(entries.len());
+                row["fusion_omitted"] = json!(run.candidates.fusion_omitted);
+                row["channels"] = json!(format!("{:?}", run.candidates.channels));
+                row["route"] = route_cost(&view, &request, &config);
+            }
+        }
+        rows.insert(c.label, row);
+    }
+    // The channel-aware judge must leave lexical-only runs untouched.
+    assert_eq!(packed_by["lexical"], packed_by["lexical/ch"], "{}", input.id);
+    let base = &packed_by["lexical"];
+    let deltas: BTreeMap<&str, Value> = packed_by
+        .iter()
+        .map(|(label, with)| {
+            let gained = with.iter().filter(|g| !base.contains(*g)).count();
+            let lost = base.iter().filter(|g| !with.contains(*g)).count();
+            (*label, json!({"packed_gold_gained": gained, "packed_gold_lost": lost}))
+        })
+        .collect();
+    out["configs"] = json!(rows);
+    out["packed_deltas_at_1024"] = json!(deltas);
+    out["lexical_index_seconds"] = json!(indexed.index_seconds);
+    out["entities"] = json!(indexed.entities);
+    out["peak_rss_kib"] = json!(rss_peak_kib());
+    drop(view);
+    let dir = indexed.dir.clone();
+    drop(indexed);
+    let _ = std::fs::remove_dir_all(&dir);
+    out
+}
