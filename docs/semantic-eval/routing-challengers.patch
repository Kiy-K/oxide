+    /// A loopback llama-server stand-in: answers `/props` and `/v1/models`
+    /// from `model_path`, and each `/v1/embeddings` call with the next
+    /// scripted (status, body). Serves `connections` requests.
+    fn llama_server(
+        model_path: &str,
+        embeddings: Vec<(u16, String)>,
+        connections: usize,
+    ) -> String {
+        use std::io::{Read, Write};
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let url = format!("http://127.0.0.1:{}", listener.local_addr().unwrap().port());
+        let props = json!({"model_path": model_path, "build_info": "b11540-1e6f04a75"}).to_string();
+        let models =
+            json!({"data": [{"id": model_path, "meta": {"n_embd": 4, "ftype": "Q4_K - Medium"}}]})
+                .to_string();
+        std::thread::spawn(move || {
+            let mut embeddings = embeddings.into_iter();
+            for _ in 0..connections {
+                let (mut stream, _) = listener.accept().unwrap();
+                let mut raw = Vec::new();
+                let mut buf = [0u8; 4096];
+                let end = loop {
+                    let n = stream.read(&mut buf).unwrap();
+                    raw.extend_from_slice(&buf[..n]);
+                    if let Some(i) = raw.windows(4).position(|w| w == b"\r\n\r\n") {
+                        break i + 4;
+                    }
+                };
+                let head = String::from_utf8_lossy(&raw[..end]).to_lowercase();
+                let length: usize = head
+                    .lines()
+                    .find_map(|l| l.strip_prefix("content-length:"))
+                    .map_or(0, |v| v.trim().parse().unwrap());
+                while raw.len() < end + length {
+                    let n = stream.read(&mut buf).unwrap();
+                    raw.extend_from_slice(&buf[..n]);
+                }
+                let path = head
+                    .split_whitespace()
+                    .nth(1)
+                    .unwrap_or_default()
+                    .to_owned();
+                let (status, body) = match path.as_str() {
+                    "/props" => (200, props.clone()),
+                    "/v1/models" => (200, models.clone()),
+                    _ => embeddings.next().unwrap(),
+                };
+                let reply = format!(
+                    "HTTP/1.1 {status} X\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
+                    body.len()
+                );
+                let _ = stream.write_all(reply.as_bytes());
+            }
+        });
+        url
+    }
+
+    fn vectors(vs: &[[f32; 4]], tokens: u32) -> (u16, String) {
+        let data: Vec<Value> = vs
+            .iter()
+            .enumerate()
+            .map(|(i, v)| json!({"object": "embedding", "index": i, "embedding": v}))
+            .collect();
+        let usage = json!({"prompt_tokens": tokens, "total_tokens": tokens});
+        let body = json!({"object": "list", "model": "lfm", "data": data, "usage": usage});
+        (200, body.to_string())
+    }
+
