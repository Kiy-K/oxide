+impl LlamaCpp {
+    /// A client for `endpoint` (the server root, without `/v1`). Contacts
+    /// nothing until called.
+    pub fn new(endpoint: Endpoint, configured: EmbeddingSpace, max_batch: usize) -> Self {
+        assert_eq!(endpoint.runner, Runner::LlamaCpp, "llama.cpp endpoint");
+        let config = ureq::Agent::config_builder()
+            .http_status_as_error(false)
+            .max_redirects(0)
+            .build();
+        Self {
+            endpoint,
+            configured,
+            max_batch,
+            http: ureq::Agent::new_with_config(config),
+            digest: Mutex::new(None),
+        }
+    }
+
+    pub fn space(&self) -> &EmbeddingSpace {
+        &self.configured
+    }
+
+    fn get(&self, path: &str, timeout: Duration) -> Result<Value, EmbedError> {
+        self.call(path, None, timeout, 1 << 20)
+    }
+
+    /// GET `path`, or POST `body` to it, within `timeout`. A non-200 status
+    /// is `ModelMissing` (404) or `Rejected` with the runner's message.
+    fn call(
+        &self,
+        path: &str,
+        body: Option<&Value>,
+        timeout: Duration,
+        limit: u64,
+    ) -> Result<Value, EmbedError> {
+        let url = format!("{}{path}", self.endpoint.url.trim_end_matches('/'));
+        let sent = match body {
+            None => self
+                .http
+                .get(&url)
+                .config()
+                .timeout_global(Some(timeout))
+                .build()
+                .call(),
+            Some(body) => self
+                .http
+                .post(&url)
+                .config()
+                .timeout_global(Some(timeout))
+                .build()
+                .header("content-type", "application/json")
+                .send(body.to_string()),
+        };
+        let mut response = sent.map_err(|e| match e {
+            ureq::Error::Timeout(_) => EmbedError::Timeout,
+            _ => EmbedError::Unavailable,
+        })?;
+        let status = response.status().as_u16();
+        let text = response
+            .body_mut()
+            .with_config()
+            .limit(limit)
+            .read_to_string()
+            .map_err(|e| match e {
+                ureq::Error::Timeout(_) => EmbedError::Timeout,
+                _ => EmbedError::Unavailable,
+            })?;
+        match status {
+            200 => serde_json::from_str(&text).map_err(|e| EmbedError::Malformed(e.to_string())),
+            404 => Err(EmbedError::ModelMissing),
+            _ => Err(EmbedError::Rejected(text)),
+        }
+    }
+
+    /// SHA-256 of the served model file, when this host can read it; hashed
+    /// once per (path, length, modification time).
+    fn model_digest(&self, path: &str) -> Option<String> {
+        let meta = std::fs::metadata(path).ok()?;
+        let stamp = (path.to_owned(), meta.len(), meta.modified().ok()?);
+        let mut cached = self.digest.lock().unwrap();
+        if let Some((p, l, m, d)) = cached.as_ref()
+            && (p, l, m) == (&stamp.0, &stamp.1, &stamp.2)
+        {
+            return Some(d.clone());
+        }
+        let mut hasher = Sha256::new();
+        let mut file = std::fs::File::open(Path::new(path)).ok()?;
+        let mut buffer = vec![0; 1 << 20];
+        loop {
+            match std::io::Read::read(&mut file, &mut buffer).ok()? {
+                0 => break,
+                n => hasher.update(&buffer[..n]),
+            }
+        }
+        let digest = crate::capture::sha256_text(hasher.finalize().as_slice());
+        *cached = Some((stamp.0, stamp.1, stamp.2, digest.clone()));
+        Some(digest)
+    }
+}
+
+impl EmbeddingProvider for LlamaCpp {
+    fn endpoint(&self) -> &Endpoint {
+        &self.endpoint
+    }
+
+    fn probe(&self, timeout: Duration) -> Result<Probe, EmbedError> {
+        let deadline = Instant::now() + timeout;
+        let left = || deadline.saturating_duration_since(Instant::now());
+        let props = self.get("/props", left())?;
+        let models = self.get("/v1/models", left())?;
+        let meta = &models["data"][0]["meta"];
+        let dimension = meta["n_embd"]
+            .as_u64()
+            .ok_or_else(|| EmbedError::Malformed("no n_embd in /v1/models".into()))?;
+        let model_digest = props["model_path"]
+            .as_str()
+            .and_then(|p| self.model_digest(p));
+        let prompt = self.configured.document_prompt.clone().unwrap_or_default();
+        let vector = self
+            .embed(&[format!("{prompt}{CANARY}")], left())?
+            .pop()
+            .ok_or_else(|| EmbedError::Malformed("no canary vector".into()))?;
+        let norm = vector.iter().map(|x| x * x).sum::<f32>().sqrt();
+        // Prompts, recipe, window and pooling are applied or proven by this
+        // client (the canary); the rest is what the server reports.
+        let same_file = model_digest.is_some() && model_digest == self.configured.model_digest;
+        let space = EmbeddingSpace {
+            runner: Runner::LlamaCpp,
+            model: self.configured.model.clone(),
+            model_digest,
+            quantization: meta["ftype"].as_str().map(str::to_owned),
+            dimension: dimension as u32,
+            metric: Metric::Cosine,
+            normalized: Some((norm - 1.0).abs() <= 1e-3),
+            pooling: self.configured.pooling.clone(),
+            tokenizer: same_file
+                .then(|| self.configured.tokenizer.clone())
+                .flatten(),
+            query_prompt: self.configured.query_prompt.clone(),
+            document_prompt: self.configured.document_prompt.clone(),
+            document_recipe: self.configured.document_recipe.clone(),
+            runner_version: props["build_info"].as_str().map(str::to_owned),
+            max_tokens: self.configured.max_tokens,
+            canary: Some(canary_of(&vector)),
+        };
+        Ok(Probe {
+            space,
+            max_batch: self.max_batch,
+        })
+    }
+
+    fn served(&self, timeout: Duration) -> Result<Option<String>, EmbedError> {
+        let props = self.get("/props", timeout)?;
+        let field = |k: &str| props[k].as_str().unwrap_or_default().to_owned();
+        Ok(Some(format!(
+            "{}|{}",
+            field("model_path"),
+            field("build_info")
+        )))
+    }
+
+    fn embed(&self, texts: &[String], timeout: Duration) -> Result<Vec<Vec<f32>>, EmbedError> {
+        if timeout.is_zero() {
+            return Err(EmbedError::Timeout);
+        }
+        let body = json!({"model": self.configured.model, "input": texts});
+        // Room for every component printed in full, plus the envelope.
+        let limit = 64 * (1 + texts.len() as u64) * (16 + u64::from(self.configured.dimension));
+        let response = self.call("/v1/embeddings", Some(&body), timeout, limit)?;
+        let data = response["data"]
+            .as_array()
+            .ok_or_else(|| EmbedError::Malformed("no data in /v1/embeddings".into()))?;
+        let mut vectors: Vec<Option<Vec<f32>>> = vec![None; texts.len()];
+        for item in data {
+            let slot = item["index"]
+                .as_u64()
+                .and_then(|i| vectors.get_mut(i as usize))
+                .ok_or_else(|| EmbedError::Malformed("embedding index out of range".into()))?;
+            let vector = item["embedding"]
+                .as_array()
+                .and_then(|v| v.iter().map(|x| x.as_f64().map(|x| x as f32)).collect())
+                .ok_or_else(|| EmbedError::Malformed("embedding is not numeric".into()))?;
+            if slot.replace(vector).is_some() {
+                return Err(EmbedError::Malformed("duplicate embedding index".into()));
+            }
+        }
+        // One text: its token count is exact, so the window is enforced.
+        if let ([_], Some(max), Some(used)) = (
+            texts,
+            self.configured.max_tokens,
+            response["usage"]["prompt_tokens"].as_u64(),
+        ) && used > u64::from(max)
+        {
+            return Err(EmbedError::Rejected(format!(
+                "{used} tokens exceed the {max}-token window"
+            )));
+        }
+        vectors
+            .into_iter()
+            .map(|v| v.ok_or_else(|| EmbedError::Malformed("missing embedding".into())))
+            .collect()
+    }
+}
