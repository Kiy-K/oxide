+/// Frozen R1 rule: the regex
+/// `(?<=[a-z0-9])(?=[A-Z])|(?<=[A-Z])(?=[A-Z][a-z])` → one ASCII space.
+/// ASCII classes only; nothing is removed or re-cased.
+fn r1_split(s: &str) -> String {
+    let c: Vec<char> = s.chars().collect();
+    let mut out = String::with_capacity(s.len() + 8);
+    for i in 0..c.len() {
+        if i > 0 {
+            let (p, n) = (c[i - 1], c[i]);
+            let a = (p.is_ascii_lowercase() || p.is_ascii_digit()) && n.is_ascii_uppercase();
+            let b = p.is_ascii_uppercase()
+                && n.is_ascii_uppercase()
+                && c.get(i + 1).is_some_and(|x| x.is_ascii_lowercase());
+            if a || b {
+                out.push(' ');
+            }
+        }
+        out.push(c[i]);
+    }
+    out
+}
