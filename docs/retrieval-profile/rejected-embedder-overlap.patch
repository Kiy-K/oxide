+    /// Everything a read request needs before its engine can be built.
+    ///
+    /// One-shot path only (`oxide search`/`oxide context` from the CLI):
+    /// when the request is going to load the whole corpus anyway
+    /// (`context`; expanding or blast-radius `search`) and the provider is
+    /// a real model rather than the hashed fallback, the corpus — snapshot
+    /// plus relation index, ~50–80 ms at 8–15k symbols — is loaded on a
+    /// worker thread through its **own** read-only connection while the
+    /// main thread pays the model load, so the two overlap instead of
+    /// running back to back. The worker's result is used only if its
+    /// connection saw the same `snapshot_key` (index id, generation, and
+    /// every identity/meta key) the request's own connection sees; a
+    /// concurrent `oxide index` finishing in between makes the keys
+    /// differ, and the preloaded corpus is dropped in favor of the
+    /// request-scoped lazy load, exactly as before. An unkeyable
+    /// (pre-counter) index is never preloaded.
+    ///
+    /// The model itself deliberately stays on the calling thread: loading
+    /// it on a helper thread measured 8–11% slower end to end and +10 MB
+    /// RSS on paths with nothing to overlap (docs/retrieval-profile/
+    /// README.md §6), so the *corpus* is what moves, not the model. The
+    /// process-cached path (`oxide mcp`) is untouched: with the cache on,
+    /// the corpus comes from the cache and nothing is spawned.
+    fn prepare(
+        &self,
+        needs_embedder: bool,
+        preload_corpus: bool,
+    ) -> Result<Prepared, ServiceError> {
+        let overlap = needs_embedder
+            && preload_corpus
+            && !self.use_process_cache
+            && crate::embeddings::configured_provider_name(None)
+                != crate::embeddings::OFFLINE_PROVIDER_NAME;
+        let index_path = self.index_path();
+        std::thread::scope(|scope| {
+            let loading = overlap.then(|| {
+                scope.spawn(
+                    move || -> Option<(Vec<String>, SymbolSnapshot, RelationIndex)> {
+                        let store = SqliteStore::open_read_only(&index_path).ok()?;
+                        let key = snapshot_key(&store).ok()??;
+                        let snapshot = SymbolSnapshot::load(&store).ok()?;
+                        let index = RelationIndex::build(&snapshot.symbols);
+                        Some((key, snapshot, index))
+                    },
+                )
+            });
+            let provider: Arc<dyn EmbeddingProvider + Send + Sync> = if needs_embedder {
+                self.embedder()?
+            } else {
+                Arc::new(HashedEmbedder::default())
+            };
+            let store = self.open_index_for_read()?;
+            let lookup = self.cache_lookup(&store)?;
+            let stats = self.stats_for(&store, &lookup)?;
+            self.validate_index(&store, needs_embedder.then_some(provider.as_ref()), &stats)?;
+            let cached = self.cached_snapshot(&store, lookup, &stats)?;
+            let local = match loading.map(|h| h.join()) {
+                Some(Ok(Some((key, snapshot, index)))) if cached.is_none() => {
+                    let own = snapshot_key(&store)?;
+                    (own.as_ref() == Some(&key)).then(|| Box::new((snapshot, index)))
+                }
+                _ => None,
+            };
+            Ok(Prepared {
+                store,
+                provider,
+                cached,
+                local,
+            })
+        })
+    }
