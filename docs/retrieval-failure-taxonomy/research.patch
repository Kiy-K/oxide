+/// RESEARCH ONLY (allocator-utilization track; lives in a /tmp worktree and
+/// is never committed). Default state is `Baseline` with tracing off, which
+/// leaves `build_context_with` byte-identical to production.
+pub mod alloc_research {
+    use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};
+    use std::sync::Mutex;
+
+    /// 0 baseline, 1 top-up, 2 diversity-aware top-up, 3 widen truncated
+    /// snippets, 4 relax primary cap only (per-file cap kept), 5 per-file
+    /// top-up (per-file-cap drops only, no tests, <= 2x per-file cap),
+    /// 6 per-file cap 2x in the main pass (in-place reallocation), 7 = 5 but
+    /// honoring the primary/test caps counted over the whole pack.
+    pub static CHALLENGER: AtomicU8 = AtomicU8::new(0);
+    pub static TRACE_ON: AtomicBool = AtomicBool::new(false);
+    pub static TRACE: Mutex<Option<serde_json::Value>> = Mutex::new(None);
+
+    pub fn set(challenger: u8, trace: bool) {
+        CHALLENGER.store(challenger, Ordering::SeqCst);
+        TRACE_ON.store(trace, Ordering::SeqCst);
+    }
+    pub fn challenger() -> u8 {
+        CHALLENGER.load(Ordering::SeqCst)
+    }
+    pub fn tracing() -> bool {
+        TRACE_ON.load(Ordering::SeqCst)
+    }
+    pub fn take() -> Option<serde_json::Value> {
+        TRACE.lock().unwrap().take()
+    }
+
+    /// Taxonomy track: Oracle C gold ids (reachable-gold expansion from the
+    /// current 16 anchors), and the #25 arm (canonical test predicate for
+    /// role assignment). Both off by default.
+    pub static ORACLE_C: Mutex<Option<std::collections::HashSet<u64>>> = Mutex::new(None);
+    pub static CANON_TEST: AtomicBool = AtomicBool::new(false);
+    /// Diagnostic arm: also treat symbols under a repo-root tests/ test/ testing/ dir as tests.
+    pub static ROOT_TESTS: AtomicBool = AtomicBool::new(false);
+    /// Oracle C variant: admitted gold scored at the top seed's score (competes for primary slots).
+    pub static ORACLE_C_TOP: AtomicBool = AtomicBool::new(false);
+    /// Oracle C variant: admitted gold gets the Primary role (honors the primary cap).
+    pub static ORACLE_C_PRIMARY: AtomicBool = AtomicBool::new(false);
+
+    /// Production snippet window for any symbol: (lo, hi, truncated, est
+    /// tokens incl. overhead) at `cap` tokens.
+    pub fn snippet_span(
+        root: &std::path::Path,
+        s: &crate::symbols::Symbol,
+        task: &str,
+        cap: usize,
+    ) -> (u32, u32, bool, usize) {
+        let terms = super::query_terms(task);
+        let (snip, lo, hi, t) = super::render_snippet_span(root, s, &terms, cap);
+        (lo, hi, t, super::estimate_tokens(&snip) + super::CONTEXT_ITEM_OVERHEAD_TOKENS)
+    }
+    pub fn local_is_test(s: &crate::symbols::Symbol) -> bool {
+        super::is_test_symbol_local(s)
+    }
+    pub fn canon_is_test(s: &crate::symbols::Symbol) -> bool {
+        let mut b = (String::new(), String::new());
+        crate::symbols::is_test_symbol(&s.file, &s.name, s.kind, &mut b)
+    }
+}
+
+fn research_key(s: &Symbol) -> String {
+    format!("{}#{}", s.file, s.qualified_name)
+}
+
 pub const CHARS_PER_TOKEN: f32 = CONTEXT_CHARS_PER_TOKEN;
 
