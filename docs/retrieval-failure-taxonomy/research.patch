index 0000000..310cdbd
--- /dev/null
+++ b/examples/taxonomy_dump.rs
@@ -0,0 +1,318 @@
+//! Failure-taxonomy research harness (research-only, /tmp worktree).
+//!
+//! Per task: injects the committed arctic-embed-xs-q semantic top-200
+//! (`taxonomy_research::SEM_OVERRIDE`), runs the real current-main search and
+//! `build_context_with` (balanced, 4096) with the allocator trace on, and
+//! dumps every stage: lexical/semantic channels, the full fused list, seeds,
+//! expansion/evidence, the pre-dedup pool, the kept pool, omissions and
+//! delivered spans. Then re-runs the pack under research arms:
+//!   B  oracle fusion order (gold ids first, same score ladder)
+//!   C  oracle expansion (gold reachable from the 16 anchors added)
+//!   T  #25: canonical `symbols::is_test_symbol` for role assignment
+//! and records a research-only literal channel (not routed in production).
+//!
+//! Usage: taxonomy_dump <repo_root> <tasks.jsonl> > out.jsonl
+//! Task line: {id, query, sem:[[key,id,score]..], gold_keys?:[..],
+//!             gold_lines?:{file:[[s,e]..]}, literal_patterns:[..]}
+use oxide::context::{alloc_research, build_context_with, ContextOptions};
+use oxide::embeddings::HashedEmbedder;
+use oxide::retrieval::{
+    taxonomy_research as tr, RetrievalEngine, RetrievalMode, SearchMode, SearchOptions,
+    SymbolSnapshot,
+};
+use oxide::storage::{IndexBackend, SqliteStore};
+use oxide::symbols::{Symbol, SymbolKind};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, HashMap, HashSet};
+use std::io::{BufRead, Write};
+
+fn key(s: &Symbol) -> String {
+    format!("{}#{}", s.file, s.qualified_name)
+}
+
+fn pack(
+    root: &std::path::Path,
+    engine: &RetrievalEngine<'_>,
+    q: &str,
+) -> anyhow::Result<(Value, usize)> {
+    alloc_research::set(0, true);
+    let p = build_context_with(root, engine, q, &ContextOptions::default())?;
+    let t = alloc_research::take().unwrap_or(Value::Null);
+    alloc_research::set(0, false);
+    Ok((t, p.used_tokens))
+}
+
+fn main() -> anyhow::Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let root = std::path::PathBuf::from(&args[1]).canonicalize()?;
+    let tasks = std::io::BufReader::new(std::fs::File::open(&args[2])?);
+    let store = SqliteStore::open_read_only(&root.join(".oxide/index.db"))?;
+    let persisted = store.get_meta(oxide::storage::LEXICAL_INDEX_KEY)?;
+    anyhow::ensure!(
+        persisted.as_deref() == Some(oxide::storage::LEXICAL_INDEX_VERSION.to_string().as_str()),
+        "no current persisted lexical index at {}",
+        root.display()
+    );
+    let embedder = HashedEmbedder::default();
+    let snapshot = SymbolSnapshot::load(&store)?;
+    let engine = RetrievalEngine::with_snapshot(&store, &embedder, &snapshot);
+    let graph = engine.relation_graph()?;
+    let full = engine.snapshot_with_relations()?;
+    // file -> symbols (for line -> bearer lookups)
+    let mut by_file: HashMap<&str, Vec<&Symbol>> = HashMap::new();
+    for s in &full.symbols {
+        by_file.entry(s.file.as_str()).or_default().push(s);
+    }
+    let by_key: HashMap<String, &Symbol> = full.symbols.iter().map(|s| (key(s), s)).collect();
+    let indexed_files: HashSet<&str> = by_file.keys().copied().collect();
+    let innermost = |file: &str, line: u32| -> Option<&Symbol> {
+        by_file.get(file).and_then(|v| {
+            v.iter()
+                .filter(|s| s.start_line <= line && line <= s.end_line)
+                .min_by_key(|s| {
+                    (
+                        s.kind == SymbolKind::Module,
+                        s.end_line - s.start_line,
+                        s.id(),
+                    )
+                })
+                .copied()
+        })
+    };
+    let out = std::io::stdout();
+    let mut out = out.lock();
+
+    for line in tasks.lines() {
+        let line = line?;
+        if line.trim().is_empty() {
+            continue;
+        }
+        let task: Value = serde_json::from_str(&line)?;
+        let q = task["query"].as_str().unwrap_or_default().to_string();
+
+        // ---- semantic override from the committed dump ----
+        let mut sem: Vec<(u64, f32)> = Vec::new();
+        let mut sem_missing: Vec<String> = Vec::new();
+        for e in task["sem"].as_array().cloned().unwrap_or_default() {
+            let k = e[0].as_str().unwrap_or_default();
+            let id: u64 = e[1].as_str().unwrap_or("0").parse().unwrap_or(0);
+            let sc = e[2].as_f64().unwrap_or(0.0) as f32;
+            match by_key.get(k) {
+                Some(s) if s.id() == id => sem.push((id, sc)),
+                _ => sem_missing.push(k.to_string()),
+            }
+        }
+        *tr::SEM_OVERRIDE.lock().unwrap() = Some(sem);
+
+        // ---- gold: lines + oracle id set ----
+        let mut gold_lines: BTreeMap<String, Vec<(u32, u32)>> = BTreeMap::new();
+        let mut gold_ids: HashSet<u64> = HashSet::new();
+        let mut gold_keys_missing: Vec<String> = Vec::new();
+        if let Some(gk) = task["gold_keys"].as_array() {
+            for k in gk {
+                let k = k.as_str().unwrap_or_default();
+                match by_key.get(k) {
+                    Some(s) => {
+                        gold_ids.insert(s.id());
+                        gold_lines
+                            .entry(s.file.clone())
+                            .or_default()
+                            .push((s.start_line, s.end_line));
+                    }
+                    None => gold_keys_missing.push(k.to_string()),
+                }
+            }
+        }
+        if let Some(gl) = task["gold_lines"].as_object() {
+            for (f, rs) in gl {
+                for r in rs.as_array().cloned().unwrap_or_default() {
+                    let (a, b) = (
+                        r[0].as_u64().unwrap_or(1) as u32,
+                        r[1].as_u64().unwrap_or(1) as u32,
+                    );
+                    gold_lines.entry(f.clone()).or_default().push((a, b));
+                    if task["gold_keys"].is_null() {
+                        for l in a..=b {
+                            if let Some(s) = innermost(f, l) {
+                                gold_ids.insert(s.id());
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        // every symbol overlapping a gold line ("bearer"), with its windows
+        let mut bearers: Vec<Value> = Vec::new();
+        let mut gold_files_unindexed: Vec<String> = Vec::new();
+        for (f, rs) in &gold_lines {
+            if !indexed_files.contains(f.as_str()) {
+                gold_files_unindexed.push(f.clone());
+                continue;
+            }
+            for s in by_file.get(f.as_str()).cloned().unwrap_or_default() {
+                if rs
+                    .iter()
+                    .any(|(a, b)| s.start_line <= *b && *a <= s.end_line)
+                {
+                    let mut c = s.clone();
+                    engine.complete(std::iter::once(&mut c))?;
+                    let (lo, hi, t, tok) = alloc_research::snippet_span(&root, &c, &q, 350);
+                    let (flo, fhi, _, ftok) =
+                        alloc_research::snippet_span(&root, &c, &q, usize::MAX / 8);
+                    bearers.push(json!({"key": key(s), "kind": format!("{:?}", s.kind),
+                        "span": [s.start_line, s.end_line], "cap_span": [lo, hi],
+                        "truncated": t, "cap_tok": tok, "full_span": [flo, fhi], "full_tok": ftok,
+                        "oracle_gold": gold_ids.contains(&s.id()),
+                        "test_local": alloc_research::local_is_test(&c),
+                        "test_canon": alloc_research::canon_is_test(&c)}));
+                }
+            }
+        }
+
+        // ---- channels + full fused list (baseline) ----
+        *tr::CHANNELS.lock().unwrap() = Some(None);
+        let fused = engine.search(
+            &q,
+            &SearchOptions {
+                limit: 100_000,
+                mode: SearchMode::Hybrid,
+                expand: false,
+                retrieval_mode: RetrievalMode::Balanced,
+            },
+        )?;
+        let (lex, semr) = tr::CHANNELS
+            .lock()
+            .unwrap()
+            .take()
+            .flatten()
+            .unwrap_or_default();
+        let name = |id: u64| -> String { snapshot.get(id).map(key).unwrap_or_default() };
+        let lex: Vec<Value> = lex.iter().map(|(i, s)| json!([name(*i), s])).collect();
+        let semr: Vec<Value> = semr.iter().map(|(i, s)| json!([name(*i), s])).collect();
+        let fused: Vec<Value> = fused
+            .iter()
+            .map(|h| json!([key(&h.symbol), h.score]))
+            .collect();
+
+        // ---- baseline pack ----
+        let (base, used) = pack(&root, &engine, &q)?;
+
+        // ---- reachability of gold from the 16 anchors ----
+        let seeds = engine.search(
+            &q,
+            &SearchOptions {
+                limit: 16,
+                mode: SearchMode::Hybrid,
+                expand: false,
+                retrieval_mode: RetrievalMode::Balanced,
+            },
+        )?;
+        let mut reach: Vec<Value> = Vec::new();
+        for (rank, seed) in seeds.iter().enumerate() {
+            for (i, (rel, n)) in graph.neighbors(&seed.symbol).into_iter().enumerate() {
+                if gold_ids.contains(&n.id()) {
+                    reach.push(json!({"key": key(n), "rel": rel, "seed_rank": rank, "pos": i}));
+                }
+            }
+            for (i, c) in graph.callers_of(&seed.symbol.name).into_iter().enumerate() {
+                if gold_ids.contains(&c.id()) && c.id() != seed.symbol.id() {
+                    reach
+                        .push(json!({"key": key(c), "rel": "caller", "seed_rank": rank, "pos": i}));
+                }
+            }
+        }
+
+        // ---- research arms ----
+        *tr::ORACLE_B.lock().unwrap() = Some(gold_ids.clone());
+        let (arm_b, _) = pack(&root, &engine, &q)?;
+        *tr::ORACLE_B.lock().unwrap() = None;
+        // bounded Oracle B variants: promote only gold within fused top-N, or
+        // gold some single channel already ranked in its top-16
+        let fr: HashMap<String, usize> = fused
+            .iter()
+            .enumerate()
+            .map(|(i, v)| (v[0].as_str().unwrap_or_default().to_string(), i + 1))
+            .collect();
+        let chan16: HashSet<String> = lex
+            .iter()
+            .take(16)
+            .chain(semr.iter().take(16))
+            .map(|v| v[0].as_str().unwrap_or_default().to_string())
+            .collect();
+        let mut arm_bn = serde_json::Map::new();
+        for (tag, n) in [("b16", 16usize), ("b20", 20), ("b50", 50), ("b100", 100), ("bchan16", 0)] {
+            let sub: HashSet<u64> = gold_ids
+                .iter()
+                .copied()
+                .filter(|id| {
+                    let k = name(*id);
+                    if n == 0 {
+                        chan16.contains(&k)
+                    } else {
+                        fr.get(&k).is_some_and(|r| *r <= n)
+                    }
+                })
+                .collect();
+            *tr::ORACLE_B.lock().unwrap() = Some(sub);
+            let (t, _) = pack(&root, &engine, &q)?;
+            arm_bn.insert(tag.into(), t);
+        }
+        *tr::ORACLE_B.lock().unwrap() = None;
+        *alloc_research::ORACLE_C.lock().unwrap() = Some(gold_ids.clone());
+        alloc_research::ORACLE_C_PRIMARY.store(true, std::sync::atomic::Ordering::SeqCst);
+        let (arm_cp, _) = pack(&root, &engine, &q)?;
+        alloc_research::ORACLE_C_TOP.store(true, std::sync::atomic::Ordering::SeqCst);
+        let (arm_ctop, _) = pack(&root, &engine, &q)?;
+        alloc_research::ORACLE_C_TOP.store(false, std::sync::atomic::Ordering::SeqCst);
+        alloc_research::ORACLE_C_PRIMARY.store(false, std::sync::atomic::Ordering::SeqCst);
+        let (arm_c, _) = pack(&root, &engine, &q)?;
+        *alloc_research::ORACLE_C.lock().unwrap() = None;
+        alloc_research::CANON_TEST.store(true, std::sync::atomic::Ordering::SeqCst);
+        let (arm_t, _) = pack(&root, &engine, &q)?;
+        alloc_research::CANON_TEST.store(false, std::sync::atomic::Ordering::SeqCst);
+        alloc_research::ROOT_TESTS.store(true, std::sync::atomic::Ordering::SeqCst);
+        let (arm_rt, _) = pack(&root, &engine, &q)?;
+        alloc_research::ROOT_TESTS.store(false, std::sync::atomic::Ordering::SeqCst);
+        *tr::SEM_OVERRIDE.lock().unwrap() = None;
+
+        // ---- research-only literal channel ----
+        let mut lit: Vec<Value> = Vec::new();
+        let mut lit_seen: HashSet<u64> = HashSet::new();
+        for pat in task["literal_patterns"]
+            .as_array()
+            .cloned()
+            .unwrap_or_default()
+        {
+            let pat = pat.as_str().unwrap_or_default();
+            if pat.len() < 3 {
+                continue;
+            }
+            let Ok(res) = oxide::literal::search(&root, pat, 200) else {
+                continue;
+            };
+            for h in res.hits {
+                if let Some(s) = innermost(&h.file, h.line) {
+                    if lit_seen.insert(s.id()) {
+                        lit.push(json!([key(s), pat, h.line]));
+                    }
+                }
+            }
+        }
+
+        let rec = json!({
+            "id": task["id"], "sem_missing": sem_missing, "gold_keys_missing": gold_keys_missing,
+            "gold_files_unindexed": gold_files_unindexed,
+            "gold_lines": gold_lines, "bearers": bearers,
+            "lexical": lex, "semantic": semr, "fused": fused, "literal": lit,
+            "reach": reach, "used": used,
+            "base": base, "arm_b": arm_b, "arm_c": arm_c, "arm_t": arm_t,
+            "arm_bn": arm_bn, "arm_cp": arm_cp, "arm_rt": arm_rt, "arm_ctop": arm_ctop,
+        });
+        writeln!(out, "{}", serde_json::to_string(&rec)?)?;
+    }
+    eprintln!(
+        "{}",
+        json!({"root": root.display().to_string(), "symbols": store.symbol_count()?})
+    );
+    Ok(())
+}
