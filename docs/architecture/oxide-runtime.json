  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Context is the spine: caller → adapter → RepositoryService → hybrid retrieval → bounded pack.",
        "Results return through the same CLI or MCP adapter; the reverse edge is intentionally omitted."
      ]
    },
    {
      "dot": "emerald",
      "title": "Indexing details",
      "items": [
        "The scanner honors Git ignore rules; changed UTF-8 files alone are reparsed.",
        "Tree-sitter extracts declarations while index-time passes add references, calls, and bases.",
        "The indexer also embeds documents; that secondary provider edge stays in this card to keep topology sparse."
      ]
    },
    {
      "dot": "violet",
      "title": "Retrieval details",
      "items": [
        "BM25 and semantic scoring run concurrently, then reciprocal-rank fusion combines evidence.",
        "Structural expansion cannot displace direct hits; context packing enforces the caller's token budget.",
        "Review uses Git diffs as seeds and shares the same retrieval and relation data."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Repository text and Git metadata are local inputs; generated .oxide state is separate persisted data.",
        "HTTP embedding sends model input across the network; native fastembed may download model weights on first use.",
        "Sentry is separate outbound telemetry and is initialized before command dispatch."
      ]
    }
  ]
