index 0000000..bca1cb8
--- /dev/null
+++ b/oxide_kernel/crates/runtime/tests/lexical_fields.rs
@@ -0,0 +1,474 @@
+//! Code-body and field-aware lexical retrieval (docs/lexical-fields-eval/):
+//! production FTS (`A`) against in-memory BM25 variants that add symbol
+//! bodies and per-field ranking, through the real pipeline with every
+//! other knob frozen. Only the answer to the store's lexical request
+//! differs. Opt-in and machine-local; no JEV, no embeddings:
+//!
+//! ```text
+//! OXIDE_CB_WORKTREES=<dir>:<dir> OXIDE_LEXICAL_SPLIT=dev OXIDE_SKIP_REPOS=sympy/sympy \
+//!   cargo test --release -p oxide-runtime --test lexical_fields -- --ignored --nocapture
+//! ```
+
+mod common;
+
+use std::collections::{BTreeMap, BTreeSet, HashMap};
+use std::path::Path;
+use std::time::Instant;
+
+use common::phase5::{self, TaskInput, data_dir, stages};
+use common::{gold_sources, metrics, repo_root, rss_peak_kib};
+use oxide_kernel::context::{baseline, build_context};
+use oxide_kernel::id::EntityId;
+use oxide_kernel::knowledge::{Entity, RepositorySnapshot};
+use oxide_kernel::lexical::{LexicalHit, LexicalRequest, LexicalResult, rank, terms};
+use oxide_kernel::source::Sources;
+use oxide_kernel::store::{
+    Adjacency, AdjacencyRequest, KnowledgeStore, MAX_REQUEST_ITEMS, Named, ReadView, StoreError,
+};
+use oxide_runtime::decisionbench::Split;
+use serde_json::{Value, json};
+
+const BUDGETS: [u32; 3] = [256, 1024, 4096];
+const K1: f64 = 1.2;
+const B: f64 = 0.75;
+/// Field order in [`Docs`].
+const NAME: usize = 0;
+const SIGNATURE: usize = 1;
+const PATH: usize = 2;
+const BODY: usize = 3;
+
+/// Body tokens with identifiers kept whole: lowercased, underscores
+/// dropped (the joined form `terms` also emits), never split into parts.
+fn joined(text: &str) -> Vec<String> {
+    text.split(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
+        .map(|w| w.replace('_', "").to_ascii_lowercase())
+        .filter(|t| t.len() > 1)
+        .collect()
+}
+
+fn cut(s: &str, max: usize) -> &str {
+    let mut end = max.min(s.len());
+    while !s.is_char_boundary(end) {
+        end -= 1;
+    }
+    &s[..end]
+}
+
+/// One field over every entity: postings and lengths.
+#[derive(Default)]
+struct Field {
+    postings: HashMap<String, Vec<(u32, u32)>>,
+    lengths: Vec<u32>,
+}
+
+impl Field {
+    fn build(tokens: &[Vec<String>]) -> Self {
+        let mut postings: HashMap<String, Vec<(u32, u32)>> = HashMap::new();
+        for (d, toks) in tokens.iter().enumerate() {
+            let mut tf: BTreeMap<&str, u32> = BTreeMap::new();
+            toks.iter().for_each(|t| *tf.entry(t).or_default() += 1);
+            for (t, n) in tf {
+                postings.entry(t.to_owned()).or_default().push((d as u32, n));
+            }
+        }
+        Field {
+            postings,
+            lengths: tokens.iter().map(|t| t.len() as u32).collect(),
+        }
+    }
+
+    fn average(&self) -> f64 {
+        self.lengths.iter().map(|&l| l as f64).sum::<f64>() / self.lengths.len().max(1) as f64
+    }
+
+    /// Posting entries plus vocabulary bytes: a size estimate.
+    fn bytes(&self) -> usize {
+        self.postings
+            .iter()
+            .map(|(t, p)| t.len() + 8 * p.len())
+            .sum()
+    }
+}
+
+fn idf(n: usize, df: usize) -> f64 {
+    (1.0 + (n as f64 - df as f64 + 0.5) / (df as f64 + 0.5)).ln()
+}
+
+/// Scorers over one set of fields.
+enum Scorer {
+    /// One document: the fields concatenated.
+    Concat,
+    /// BM25F: per-field length normalization, unit weights, one IDF.
+    Bm25f,
+    /// Each field ranked alone, fused by unweighted RRF (k = 60).
+    Rrf,
+}
+
+fn score(
+    fields: &[&Field],
+    scorer: &Scorer,
+    ids: &[EntityId],
+    query: &BTreeMap<String, f64>,
+) -> Vec<(u32, f64)> {
+    let n = ids.len();
+    let mut scores: HashMap<u32, f64> = HashMap::new();
+    match scorer {
+        Scorer::Concat | Scorer::Bm25f => {
+            let concat = matches!(scorer, Scorer::Concat);
+            let lengths: Vec<f64> = (0..n)
+                .map(|d| fields.iter().map(|f| f.lengths[d] as f64).sum())
+                .collect();
+            let average = lengths.iter().sum::<f64>() / n.max(1) as f64;
+            let averages: Vec<f64> = fields.iter().map(|f| f.average()).collect();
+            for (t, q) in query {
+                // tf (concat) or normalized tf (BM25F) per document.
+                let mut tf: HashMap<u32, f64> = HashMap::new();
+                for (i, f) in fields.iter().enumerate() {
+                    for &(d, c) in f.postings.get(t).map_or(&[][..], Vec::as_slice) {
+                        let c = c as f64;
+                        let v = if concat {
+                            c
+                        } else {
+                            let norm = 1.0 - B + B * f.lengths[d as usize] as f64 / averages[i].max(1e-9);
+                            c / norm
+                        };
+                        *tf.entry(d).or_default() += v;
+                    }
+                }
+                let w = idf(n, tf.len());
+                for (d, f) in tf {
+                    let s = if concat {
+                        let norm = K1 * (1.0 - B + B * lengths[d as usize] / average);
+                        f * (K1 + 1.0) / (f + norm)
+                    } else {
+                        f * (K1 + 1.0) / (f + K1)
+                    };
+                    *scores.entry(d).or_default() += q * w * s;
+                }
+            }
+        }
+        Scorer::Rrf => {
+            for f in fields {
+                let mut ranked = score(&[f], &Scorer::Concat, ids, query);
+                order(&mut ranked, ids);
+                for (r, (d, _)) in ranked.into_iter().enumerate() {
+                    *scores.entry(d).or_default() += 1.0 / (60.0 + r as f64 + 1.0);
+                }
+            }
+        }
+    }
+    let mut out: Vec<(u32, f64)> = scores.into_iter().filter(|(_, s)| *s > 0.0).collect();
+    order(&mut out, ids);
+    out
+}
+
+fn order(hits: &mut [(u32, f64)], ids: &[EntityId]) {
+    hits.sort_by(|a, b| {
+        b.1.total_cmp(&a.1)
+            .then_with(|| ids[a.0 as usize].cmp(&ids[b.0 as usize]))
+    });
+}
+
+/// A pinned view whose lexical channel answers from a precomputed ranking.
+struct Answer<'a, V: ReadView> {
+    view: &'a V,
+    scorer: String,
+    hits: Vec<LexicalHit>,
+}
+
+impl<V: ReadView> ReadView for Answer<'_, V> {
+    fn snapshot(&self) -> &RepositorySnapshot {
+        self.view.snapshot()
+    }
+    fn entities(&self, ids: &[EntityId]) -> Result<Vec<Option<Entity>>, StoreError> {
+        self.view.entities(ids)
+    }
+    fn adjacency(&self, request: &AdjacencyRequest) -> Result<Adjacency, StoreError> {
+        self.view.adjacency(request)
+    }
+    fn lexical(&self, request: &LexicalRequest) -> Result<LexicalResult, StoreError> {
+        rank(self.scorer.clone(), self.hits.clone(), request.limit).map_err(StoreError::Corrupt)
+    }
+    fn named(&self, name: &str, limit: usize) -> Result<Named, StoreError> {
+        self.view.named(name, limit)
+    }
+}
+
+fn rss_kib() -> u64 {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    let line = status.lines().find(|l| l.starts_with("VmRSS:"));
+    line.and_then(|l| l.split_whitespace().nth(1)?.parse().ok())
+        .unwrap_or(0)
+}
+
+fn dir_bytes(dir: &Path) -> u64 {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return 0;
+    };
+    entries
+        .flatten()
+        .map(|e| match e.metadata() {
+            Ok(m) if m.is_dir() => dir_bytes(&e.path()),
+            Ok(m) => m.len(),
+            Err(_) => 0,
+        })
+        .sum()
+}
+
+fn ranked(list: &[EntityId], gold: &BTreeSet<EntityId>) -> Value {
+    let at = |k: usize| list.iter().take(k).filter(|e| gold.contains(e)).count() as f64;
+    let n = gold.len().max(1) as f64;
+    let first = list.iter().position(|e| gold.contains(e));
+    json!({"r10": at(10) / n, "r20": at(20) / n, "r100": at(100) / n,
+           "mrr": first.map_or(0.0, |p| 1.0 / (p + 1) as f64)})
+}
+
+fn median(mut xs: Vec<f64>) -> f64 {
+    xs.sort_by(f64::total_cmp);
+    xs[xs.len() / 2]
+}
+
+fn measure(t: &Value) -> Value {
+    let indexed = phase5::index_task(t, &data_dir());
+    let store_bytes = dir_bytes(&indexed.dir);
+    let view = indexed.store.open(&indexed.key).unwrap();
+    let query = t["query"].as_str().unwrap();
+    let input = TaskInput {
+        id: t["id"].as_str().unwrap(),
+        repository: t["repo"].as_str().unwrap(),
+        split: Split::Dev,
+        query,
+        symbols: Vec::new(),
+        gold: indexed.gold.clone(),
+    };
+    let all: Vec<EntityId> = indexed.gold.verified.iter().cloned().collect();
+    let all_sources = gold_sources(&view, &all);
+    let gold_symbols: Vec<EntityId> = all
+        .iter()
+        .filter(|g| matches!(g, EntityId::Symbol(_)))
+        .cloned()
+        .collect();
+    let symbol_sources = gold_sources(&view, &gold_symbols);
+    let gold_set: BTreeSet<EntityId> = gold_symbols.iter().cloned().collect();
+    let wanted: BTreeMap<String, f64> = terms(query).into_iter().map(|t| (t, 1.0)).collect();
+    // Post-hoc diagnostic weighting: each query term by its multiplicity.
+    let mut counted: BTreeMap<String, f64> = BTreeMap::new();
+    terms(query).into_iter().for_each(|t| *counted.entry(t).or_default() += 1.0);
+
+    // Production lexical: cold first call on a fresh view, then warm.
+    let request = LexicalRequest {
+        terms: terms(query),
+        limit: 100,
+    };
+    let t0 = Instant::now();
+    let production = view.lexical(&request).unwrap();
+    let a_cold = t0.elapsed().as_secs_f64() * 1e3;
+    let a_warm = median(
+        (0..3)
+            .map(|_| {
+                let t0 = Instant::now();
+                view.lexical(&request).unwrap();
+                t0.elapsed().as_secs_f64() * 1e3
+            })
+            .collect(),
+    );
+
+    // Fields of every entity but the repository, as the FTS indexes them.
+    let rss_before = rss_kib();
+    let started = Instant::now();
+    let ids: Vec<EntityId> = indexed
+        .ids
+        .iter()
+        .filter(|id| **id != EntityId::Repository)
+        .cloned()
+        .collect();
+    let mut entities = Vec::with_capacity(ids.len());
+    for chunk in ids.chunks(MAX_REQUEST_ITEMS) {
+        entities.extend(view.entities(chunk).unwrap().into_iter().map(Option::unwrap));
+    }
+    let path_of = |e: &Entity| match &e.id {
+        EntityId::File(p) => p.as_str().to_owned(),
+        EntityId::Symbol(s) => s.file().as_str().to_owned(),
+        _ => String::new(),
+    };
+    let names: Vec<Vec<String>> = entities.iter().map(|e| terms(&e.name)).collect();
+    let signatures: Vec<Vec<String>> = entities
+        .iter()
+        .map(|e| e.signature.as_deref().map(terms).unwrap_or_default())
+        .collect();
+    let paths: Vec<Vec<String>> = entities.iter().map(|e| terms(&path_of(e))).collect();
+    let fields_ms = started.elapsed().as_secs_f64() * 1e3;
+    let started = Instant::now();
+    let mut sources = Sources::new(&view);
+    let bodies: Vec<Option<String>> = entities
+        .iter()
+        .map(|e| {
+            let source = e.source.as_ref().filter(|_| matches!(e.id, EntityId::Symbol(_)))?;
+            let Ok(Ok(bytes)) = sources.file(&source.file, &source.digest) else {
+                return None;
+            };
+            let range = source.range.start as usize..source.range.end as usize;
+            bytes.get(range).and_then(|b| std::str::from_utf8(b).ok()).map(str::to_owned)
+        })
+        .collect();
+    let hydrate_ms = started.elapsed().as_secs_f64() * 1e3;
+    let field_build = Instant::now();
+    let name = Field::build(&names);
+    let signature = Field::build(&signatures);
+    let path = Field::build(&paths);
+    let meta_ms = field_build.elapsed().as_secs_f64() * 1e3;
+    let body_of = |cap: usize, split: bool| -> (Field, f64) {
+        let t0 = Instant::now();
+        let tokens: Vec<Vec<String>> = bodies
+            .iter()
+            .map(|b| match b {
+                Some(text) if split => terms(cut(text, cap)),
+                Some(text) => joined(cut(text, cap)),
+                None => Vec::new(),
+            })
+            .collect();
+        let f = Field::build(&tokens);
+        (f, t0.elapsed().as_secs_f64() * 1e3)
+    };
+    let (body, body_ms) = body_of(2048, true);
+    let rss_main = rss_kib();
+    let (body512, _) = body_of(512, true);
+    let (body_full, _) = body_of(65536, true);
+    let (body_joined, _) = body_of(2048, false);
+    let with_body: Vec<&String> = bodies.iter().flatten().collect();
+    let truncated = |cap: usize| with_body.iter().filter(|b| b.len() > cap).count() as f64 / with_body.len().max(1) as f64;
+    let body_stats = json!({
+        "symbols_with_body": with_body.len(), "entities": ids.len(),
+        "body_bytes_median": median(with_body.iter().map(|b| b.len() as f64).collect()),
+        "truncated_share": {"512": truncated(512), "2048": truncated(2048), "65536": truncated(65536)},
+        "body_terms_mean_2048": body.lengths.iter().map(|&l| l as f64).sum::<f64>() / with_body.len().max(1) as f64,
+        "vocabulary": {"name+signature+path": name.postings.len() + signature.postings.len() + path.postings.len(),
+                       "body_2048": body.postings.len(), "body_2048_joined": body_joined.postings.len()},
+    });
+    let cost = json!({
+        "store_bytes": store_bytes, "index_seconds": indexed.index_seconds,
+        "fields_ms": fields_ms, "hydrate_ms": hydrate_ms, "meta_build_ms": meta_ms, "body_build_ms": body_ms,
+        "meta_index_bytes": name.bytes() + signature.bytes() + path.bytes(),
+        "body_index_bytes_2048": body.bytes(),
+        "rss_growth_kib": rss_main.saturating_sub(rss_before),
+        "a_cold_ms": a_cold, "a_warm_ms": a_warm,
+    });
+
+    let meta = [&name, &signature, &path];
+    let configs: Vec<(&str, Vec<&Field>, Scorer)> = vec![
+        ("A0-qtf", meta.to_vec(), Scorer::Concat),
+        ("B-qtf", vec![&name, &signature, &path, &body], Scorer::Concat),
+        ("C-qtf", vec![&name, &signature, &path, &body], Scorer::Bm25f),
+        ("A0", meta.to_vec(), Scorer::Concat),
+        ("B", vec![&name, &signature, &path, &body], Scorer::Concat),
+        ("C", vec![&name, &signature, &path, &body], Scorer::Bm25f),
+        ("C-rrf", vec![&name, &signature, &path, &body], Scorer::Rrf),
+        ("B512", vec![&name, &signature, &path, &body512], Scorer::Concat),
+        ("Bfull", vec![&name, &signature, &path, &body_full], Scorer::Concat),
+        ("B-joined", vec![&name, &signature, &path, &body_joined], Scorer::Concat),
+    ];
+    debug_assert_eq!((NAME, SIGNATURE, PATH, BODY), (0, 1, 2, 3));
+
+    let a_entries: Vec<EntityId> = production.hits.iter().map(|h| h.entity.clone()).collect();
+    let mut rows = BTreeMap::new();
+    let mut run = |label: &str, answer: Option<(&str, Vec<LexicalHit>)>, ranking: Vec<EntityId>, latency: Value| {
+        let mut row = json!({"channel": ranked(&ranking, &gold_set), "latency": latency});
+        let top20: BTreeSet<&EntityId> = ranking.iter().take(20).collect();
+        let a20: BTreeSet<&EntityId> = a_entries.iter().take(20).collect();
+        row["unique_gold_vs_A"] = json!(gold_set.iter().filter(|g| top20.contains(g) && !a20.contains(g)).count());
+        row["lost_gold_vs_A"] = json!(gold_set.iter().filter(|g| a20.contains(g) && !top20.contains(g)).count());
+        for budget in BUDGETS {
+            let request = phase5::request(&input, budget);
+            let built = match &answer {
+                None => build_context(&view, &view, &request, &baseline(), None).unwrap(),
+                Some((scorer, hits)) => {
+                    let wrapped = Answer { view: &view, scorer: scorer.to_string(), hits: hits.clone() };
+                    build_context(&wrapped, &view, &request, &baseline(), None).unwrap()
+                }
+            };
+            assert!(built.bundle.used_tokens <= budget);
+            let m = metrics(&all, &all_sources, &built);
+            let s = stages(&built, &gold_symbols, &symbol_sources);
+            let symbol_recall = s["packed"].as_u64().unwrap() as f64 / gold_symbols.len().max(1) as f64;
+            row[format!("@{budget}")] = json!({
+                "required_symbol_recall": m["required_symbol_recall"], "symbol_recall": symbol_recall,
+                "routed_gold_coverage": m["routed_gold_coverage"], "selection_loss": m["selection_loss"],
+                "packing_loss": m["packing_loss"], "stages": s});
+            if budget == 1024 {
+                let entries: Vec<EntityId> = built.candidates.entries.iter().map(|e| e.entity.clone()).collect();
+                row["entries"] = ranked(&entries, &gold_set);
+            }
+        }
+        rows.insert(label.to_owned(), row);
+    };
+    run("A", None, a_entries.clone(), json!({"cold_ms": a_cold, "warm_ms": a_warm}));
+    for (label, fields, scorer) in &configs {
+        let t0 = Instant::now();
+        let q = if label.ends_with("-qtf") { &counted } else { &wanted };
+        let scored = score(fields, scorer, &ids, q);
+        let cold = t0.elapsed().as_secs_f64() * 1e3;
+        let warm = median(
+            (0..3)
+                .map(|_| {
+                    let t0 = Instant::now();
+                    score(fields, scorer, &ids, q);
+                    t0.elapsed().as_secs_f64() * 1e3
+                })
+                .collect(),
+        );
+        let hits: Vec<LexicalHit> = scored
+            .iter()
+            .map(|(d, s)| LexicalHit { entity: ids[*d as usize].clone(), score: *s })
+            .collect();
+        let ranking: Vec<EntityId> = hits.iter().take(100).map(|h| h.entity.clone()).collect();
+        let name = format!("mem-bm25;{label};oxide-terms-v1;k1={K1};b={B};nostem");
+        run(label, Some((&name, hits)), ranking, json!({"cold_ms": cold, "warm_ms": warm}));
+    }
+    let out = json!({"task": input.id, "repo": input.repository, "gold": all.len(),
+                     "gold_symbols": gold_set.len(), "query_terms": wanted.len(),
+                     "body": body_stats, "cost": cost, "configs": rows, "peak_rss_kib": rss_peak_kib()});
+    drop(view);
+    let dir = indexed.dir.clone();
+    drop(indexed);
+    let _ = std::fs::remove_dir_all(&dir);
+    out
+}
+
+#[test]
+#[ignore = "machine-local: needs ContextBench worktrees"]
+fn lexical_fields() {
+    let split = std::env::var("OXIDE_LEXICAL_SPLIT").unwrap_or_else(|_| "dev".into());
+    let skip: Vec<String> = std::env::var("OXIDE_SKIP_REPOS")
+        .map(|r| r.split(',').map(str::to_owned).collect())
+        .unwrap_or_default();
+    // Test stays sealed: only dev and calibration are accepted.
+    let wanted = match split.as_str() {
+        "dev" => Split::Dev,
+        "calibration" => Split::Calibration,
+        other => panic!("split {other} is not open"),
+    };
+    let docs = repo_root().join("docs/phase-5/decisionbench-v1");
+    let read = |f: &str| -> Value {
+        serde_json::from_str(&std::fs::read_to_string(docs.join(f)).unwrap()).unwrap()
+    };
+    let splits: BTreeMap<String, Split> =
+        serde_json::from_value(read("splits.json")["repositories"].clone()).unwrap();
+    let spec = read("contextbench-tasks.json");
+    let cache = data_dir().join("lexical-fields").join(&split);
+    std::fs::create_dir_all(&cache).unwrap();
+    let mut tasks = Vec::new();
+    for t in spec["tasks"].as_array().unwrap() {
+        let repo = t["repo"].as_str().unwrap();
+        if splits[repo] != wanted || skip.iter().any(|r| r == repo) {
+            continue;
+        }
+        let id = t["id"].as_str().unwrap();
+        eprintln!("{id}");
+        let r = measure(t);
+        std::fs::write(cache.join(format!("{id}.json")), serde_json::to_string(&r).unwrap()).unwrap();
+        tasks.push(r);
+    }
+    let out = json!({"split": split, "skipped_repos": skip, "tasks": tasks});
+    let target = repo_root().join(format!("docs/lexical-fields-eval/{split}.json"));
+    std::fs::write(&target, serde_json::to_string_pretty(&out).unwrap() + "\n").unwrap();
+}
