+/// RESEARCH ONLY (#42 TreeSelect v0; `docs/treeselect-eval/research.patch`,
+/// never merged). Default state (no arm, tracing off) leaves
+/// `build_context_with` byte-identical to production. Tracing with no arm
+/// (arm A) keeps the production pack and records its delivered snippet
+/// spans. An arm replaces only what follows the relevance floor; arms with
+/// `post_expansion` also skip production's RelationGraph expansion.
+pub mod treeselect_research {
+    use super::{
+        dedup_reasons, estimate_tokens, overlap_ratio, query_terms, render, render_snippet_span,
+        ContextItem, ContextOptions, ContextPack, Omitted, Origin, Pooled, Role,
+    };
+    use crate::config::{
+        CONTEXT_EXPANSION_PER_SEED, CONTEXT_EXPANSION_TOTAL, CONTEXT_ITEM_OVERHEAD_TOKENS,
+        CONTEXT_MAX_TESTS, CONTEXT_PER_ITEM_TOKEN_CAP, CONTEXT_RELEVANCE_FLOOR_FRACTION,
+    };
+    use crate::evidence::candidate::{Candidate, Reason};
+    use crate::gitctx::GitEvidence;
+    use crate::relations::RelationGraph;
+    use crate::retrieval::RetrievalEngine;
+    use crate::symbols::{Symbol, SymbolKind};
+    use std::collections::{HashMap, HashSet};
+    use std::path::Path;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::sync::Mutex;
+
+    /// One research arm. Token matching is the harness's job (it sets
+    /// `ContextOptions::budget_tokens`), so T4096 is `T` at budget 4096.
+    #[derive(Debug, Clone, Copy, PartialEq, Eq)]
+    pub struct Arm {
+        /// TreeSelect order (steps 2–4); `false` keeps production's
+        /// role-then-score order (arm B).
+        pub tree: bool,
+        /// Step 4 collapse.
+        pub collapse: bool,
+        /// Step 5: expand from the first 5 selected items after selection,
+        /// instead of production's expansion from the top-5 seeds.
+        pub post_expansion: bool,
+    }
+    pub const B: Arm = Arm {
+        tree: false,
+        collapse: false,
+        post_expansion: false,
+    };
+    pub const TX: Arm = Arm {
+        tree: true,
+        collapse: true,
+        post_expansion: false,
+    };
+    pub const T: Arm = Arm {
+        tree: true,
+        collapse: true,
+        post_expansion: true,
+    };
+    pub const TC: Arm = Arm {
+        tree: true,
+        collapse: false,
+        post_expansion: true,
+    };
+
+    static TRACE_ON: AtomicBool = AtomicBool::new(false);
+    static ARM: Mutex<Option<Arm>> = Mutex::new(None);
+    pub(super) static TRACE: Mutex<Option<serde_json::Value>> = Mutex::new(None);
+
+    pub fn set(trace: bool, arm: Option<Arm>) {
+        TRACE_ON.store(trace, Ordering::SeqCst);
+        *ARM.lock().unwrap() = arm;
+    }
+    pub fn tracing() -> bool {
+        TRACE_ON.load(Ordering::SeqCst)
+    }
+    pub fn arm() -> Option<Arm> {
+        *ARM.lock().unwrap()
+    }
+    pub fn take() -> Option<serde_json::Value> {
+        TRACE.lock().unwrap().take()
+    }
+
+    pub(super) fn key(s: &Symbol) -> String {
+        format!("{}#{}", s.file, s.qualified_name)
+    }
+
+    pub(super) type Spans = HashMap<u64, (u32, u32, bool)>;
+
+    pub(super) fn trace(
+        items: &[ContextItem],
+        spans: &Spans,
+        used: usize,
+        dropped: &[Omitted],
+        offers: Option<&[(Pooled, &'static str)]>,
+    ) {
+        let packed: Vec<serde_json::Value> = items
+            .iter()
+            .map(|i| {
+                let (lo, hi, t) = spans.get(&i.symbol.id()).copied().unwrap_or((0, 0, false));
+                serde_json::json!({"key": key(&i.symbol), "role": i.role, "est": i.est_tokens,
+                    "span": [lo, hi], "truncated": t, "added": false})
+            })
+            .collect();
+        let offers: Vec<serde_json::Value> = offers
+            .unwrap_or_default()
+            .iter()
+            .map(|(c, src)| serde_json::json!([key(&c.candidate.symbol), src, c.candidate.score]))
+            .collect();
+        *TRACE.lock().unwrap() = Some(serde_json::json!({
+            "packed": packed, "used": used, "offers": offers,
+            "omitted": dropped.iter().map(|o| serde_json::json!([o.id, o.why])).collect::<Vec<_>>(),
+        }));
+    }
+
+    /// Everything after the relevance floor, for one arm. `kept` is the
+    /// production pool after dedup and floor, in production role order.
+    #[allow(clippy::too_many_arguments)]
+    pub(super) fn pack(
+        root: &Path,
+        engine: &RetrievalEngine<'_>,
+        task: &str,
+        opts: &ContextOptions,
+        top_seed: Option<f32>,
+        kept: Vec<Pooled>,
+        mut dropped: Vec<Omitted>,
+        graph: Option<&RelationGraph<'_>>,
+        arm: Arm,
+        git: Option<GitEvidence>,
+        diagnostics: Vec<String>,
+    ) -> anyhow::Result<ContextPack> {
+        let terms = query_terms(task);
+        let pooled: HashSet<u64> = kept.iter().map(|c| c.candidate.symbol.id()).collect();
+        // The floor applied to `kept` iff something cleared it (production
+        // keeps the whole weak pool when nothing does).
+        let floor = top_seed
+            .map(|t| t * CONTEXT_RELEVANCE_FLOOR_FRACTION)
+            .filter(|f| kept.iter().any(|c| c.candidate.score >= *f));
+        let mut offers: Vec<(Pooled, &'static str)> = if arm.tree {
+            tree_order(root, engine, kept, arm.collapse)?
+        } else {
+            kept.into_iter().map(|c| (c, "flat")).collect()
+        };
+        if arm.post_expansion {
+            if let Some(g) = graph {
+                let ns = expand(engine, g, &offers, &pooled, floor, &mut dropped)?;
+                offers.extend(ns.into_iter().map(|c| (c, "expansion")));
+            }
+        }
+        let (mut items, used, spans) =
+            fill(root, &terms, opts.budget_tokens, &offers, &mut dropped);
+        items.sort_by(|a, b| {
+            a.role
+                .rank()
+                .cmp(&b.role.rank())
+                .then(
+                    b.score
+                        .partial_cmp(&a.score)
+                        .unwrap_or(std::cmp::Ordering::Equal),
+                )
+                .then_with(|| a.symbol.id().cmp(&b.symbol.id()))
+        });
+        if tracing() {
+            trace(&items, &spans, used, &dropped, Some(&offers));
+        }
+        Ok(ContextPack {
+            task: task.to_string(),
+            query_used: task.to_string(),
+            embedder: engine.embedder().name().to_string(),
+            budget_tokens: opts.budget_tokens,
+            used_tokens: used,
+            omitted: dropped,
+            items,
+            git,
+            diagnostics,
+        })
+    }
+
+    /// Step 6: production's fill loop (shrink-to-fit, item overhead, 1-test
+    /// cap) in `offers` order, without the primary and per-file caps.
+    fn fill(
+        root: &Path,
+        terms: &[String],
+        budget: usize,
+        offers: &[(Pooled, &'static str)],
+        dropped: &mut Vec<Omitted>,
+    ) -> (Vec<ContextItem>, usize, Spans) {
+        let mut items = Vec::new();
+        let mut used = 0usize;
+        let mut tests = 0usize;
+        let mut spans = Spans::new();
+        for (c, _) in offers {
+            let cid = key(&c.candidate.symbol);
+            if c.role == Role::Test {
+                if tests >= CONTEXT_MAX_TESTS {
+                    dropped.push(Omitted {
+                        id: cid,
+                        why: "beyond test cap".into(),
+                    });
+                    continue;
+                }
+                tests += 1;
+            }
+            let mut cap = CONTEXT_PER_ITEM_TOKEN_CAP.min(budget);
+            let (snippet, est, span) = loop {
+                let (snip, lo, hi, t) = render_snippet_span(root, &c.candidate.symbol, terms, cap);
+                let e = estimate_tokens(&snip) + CONTEXT_ITEM_OVERHEAD_TOKENS;
+                if used + e <= budget || cap == 0 {
+                    break (snip, e, (lo, hi, t));
+                }
+                cap /= 2;
+            };
+            if used + est > budget {
+                dropped.push(Omitted {
+                    id: cid,
+                    why: "over token budget".into(),
+                });
+                if c.role == Role::Test {
+                    tests -= 1;
+                }
+                continue;
+            }
+            used += est;
+            spans.insert(c.candidate.symbol.id(), span);
+            items.push(ContextItem {
+                symbol: c.candidate.symbol.clone(),
+                role: c.role,
+                score: c.candidate.score,
+                reasons: dedup_reasons(&render(&c.candidate.reasons)),
+                snippet,
+                est_tokens: est,
+            });
+        }
+        (items, used, spans)
+    }
+
+    enum Kind {
+        Root,
+        Dir,
+        File,
+        Sym(Symbol),
+        Leaf(usize),
+    }
+
+    struct Node {
+        kind: Kind,
+        /// Tie-break path: the directory for a directory node, else the file.
+        path: String,
+        /// Tie-break id: the symbol id for symbol and leaf nodes, else 0.
+        id: u64,
+        children: Vec<usize>,
+        by_key: HashMap<String, usize>,
+        sum: f64,
+        n: usize,
+    }
+
+    impl Node {
+        fn new(kind: Kind, path: String, id: u64) -> Self {
+            Self {
+                kind,
+                path,
+                id,
+                children: Vec::new(),
+                by_key: HashMap::new(),
+                sum: 0.0,
+                n: 0,
+            }
+        }
+        /// PageIndex-adapted NodeScore: Σ leaf scores / √(N + 1).
+        fn value(&self) -> f64 {
+            self.sum / ((self.n + 1) as f64).sqrt()
+        }
+        fn is_leaf(&self) -> bool {
+            matches!(self.kind, Kind::Leaf(_))
+        }
+    }
+
+    /// Steps 2–4: build root → parent directory → file → symbols (nested by
+    /// span containment among the file's indexed symbols) over `kept`, then
+    /// pop nodes best-first by NodeScore and return the offer order.
+    fn tree_order(
+        root: &Path,
+        engine: &RetrievalEngine<'_>,
+        kept: Vec<Pooled>,
+        collapse: bool,
+    ) -> anyhow::Result<Vec<(Pooled, &'static str)>> {
+        if kept.is_empty() {
+            return Ok(Vec::new());
+        }
+        let corpus = &engine.snapshot_with_relations()?.symbols;
+        let files: HashSet<&str> = kept
+            .iter()
+            .map(|c| c.candidate.symbol.file.as_str())
+            .collect();
+        let mut by_file: HashMap<&str, Vec<&Symbol>> = HashMap::new();
+        for s in corpus.iter().filter(|s| files.contains(s.file.as_str())) {
+            by_file.entry(s.file.as_str()).or_default().push(s);
+        }
+        let mut nodes = vec![Node::new(Kind::Root, String::new(), 0)];
+        for (i, c) in kept.iter().enumerate() {
+            let s = &c.candidate.symbol;
+            let dir = s.file.rsplit_once('/').map_or("", |(d, _)| d).to_string();
+            let mut containers: Vec<&Symbol> = by_file
+                .get(s.file.as_str())
+                .map(|v| {
+                    v.iter()
+                        .copied()
+                        .filter(|x| {
+                            !matches!(x.kind, SymbolKind::Module | SymbolKind::Import)
+                                && x.start_line <= s.start_line
+                                && s.end_line <= x.end_line
+                                && (x.start_line, x.end_line) != (s.start_line, s.end_line)
+                        })
+                        .collect()
+                })
+                .unwrap_or_default();
+            containers.sort_by(|a, b| {
+                (b.end_line.saturating_sub(b.start_line))
+                    .cmp(&a.end_line.saturating_sub(a.start_line))
+                    .then(a.id().cmp(&b.id()))
+            });
+            let mut path: Vec<(String, Kind, String, u64)> = vec![
+                (format!("d:{dir}"), Kind::Dir, dir.clone(), 0),
+                (format!("f:{}", s.file), Kind::File, s.file.clone(), 0),
+            ];
+            for x in containers {
+                path.push((
+                    format!("s:{}", x.id()),
+                    Kind::Sym(x.clone()),
+                    s.file.clone(),
+                    x.id(),
+                ));
+            }
+            path.push((format!("l:{i}"), Kind::Leaf(i), s.file.clone(), s.id()));
+            let score = c.candidate.score as f64;
+            let mut cur = 0usize;
+            nodes[0].sum += score;
+            nodes[0].n += 1;
+            for (k, kind, p, id) in path {
+                let next = match nodes[cur].by_key.get(&k) {
+                    Some(&n) => n,
+                    None => {
+                        nodes.push(Node::new(kind, p, id));
+                        let n = nodes.len() - 1;
+                        nodes[cur].by_key.insert(k, n);
+                        nodes[cur].children.push(n);
+                        n
+                    }
+                };
+                nodes[next].sum += score;
+                nodes[next].n += 1;
+                cur = next;
+            }
+        }
+        // Dynamic flattening: a node with a single child is replaced by it.
+        let flat = |mut v: usize| {
+            while !nodes[v].is_leaf() && nodes[v].children.len() == 1 {
+                v = nodes[v].children[0];
+            }
+            v
+        };
+        // The frontier starts with the root's children (the root itself is
+        // never flattened: #42 amendment 1).
+        let mut frontier: Vec<usize> = nodes[0].children.iter().map(|&c| flat(c)).collect();
+        let mut slots: Vec<Option<Pooled>> = kept.into_iter().map(Some).collect();
+        let mut out = Vec::new();
+        while !frontier.is_empty() {
+            // Highest NodeScore; ties: lower path, then lower symbol id.
+            let bi = (0..frontier.len())
+                .max_by(|&a, &b| {
+                    let (x, y) = (&nodes[frontier[a]], &nodes[frontier[b]]);
+                    x.value()
+                        .partial_cmp(&y.value())
+                        .unwrap_or(std::cmp::Ordering::Equal)
+                        .then_with(|| y.path.cmp(&x.path))
+                        .then_with(|| y.id.cmp(&x.id))
+                })
+                .unwrap();
+            let v = frontier.swap_remove(bi);
+            if let Kind::Leaf(i) = nodes[v].kind {
+                out.push((slots[i].take().expect("each leaf is offered once"), "tree"));
+                continue;
+            }
+            if collapse && nodes[v].n >= 2 {
+                let container = match &nodes[v].kind {
+                    // The file-level Module symbol (`<file>:__module__`), not an
+                    // inner module/namespace of the same kind (#42 amendment 1).
+                    Kind::File => by_file.get(nodes[v].path.as_str()).and_then(|ss| {
+                        let file_module = format!("{}:__module__", nodes[v].path);
+                        ss.iter()
+                            .filter(|s| {
+                                s.kind == SymbolKind::Module && s.qualified_name == file_module
+                            })
+                            .min_by_key(|s| s.id())
+                            .map(|s| (*s).clone())
+                    }),
+                    Kind::Sym(s) if s.kind == SymbolKind::Class => Some(s.clone()),
+                    _ => None,
+                };
+                if let Some(c) =
+                    container.filter(|c| body_tokens(root, c) <= CONTEXT_PER_ITEM_TOKEN_CAP)
+                {
+                    let mut leaves = Vec::new();
+                    let mut stack = vec![v];
+                    while let Some(u) = stack.pop() {
+                        match nodes[u].kind {
+                            Kind::Leaf(i) => leaves.push(slots[i].take().expect("unoffered leaf")),
+                            _ => stack.extend(nodes[u].children.iter().copied()),
+                        }
+                    }
+                    out.push((collapsed(engine, c, leaves)?, "collapse"));
+                    continue;
+                }
+            }
+            frontier.extend(nodes[v].children.iter().map(|&c| flat(c)));
+        }
+        Ok(out)
+    }
+
+    /// Estimated tokens of `s`'s full body (`usize::MAX` when unreadable).
+    fn body_tokens(root: &Path, s: &Symbol) -> usize {
+        let Ok(src) = std::fs::read_to_string(root.join(&s.file)) else {
+            return usize::MAX;
+        };
+        let lines: Vec<&str> = src.lines().collect();
+        let lo = s.start_line.saturating_sub(1) as usize;
+        let hi = (s.end_line as usize).min(lines.len());
+        if hi <= lo {
+            return usize::MAX;
+        }
+        estimate_tokens(&lines[lo..hi].join("\n"))
+    }
+
+    /// A collapsed container offered in place of its leaves: the highest leaf
+    /// score, the best leaf role (primary before dependency before test) and
+    /// the union of the leaves' reasons in score order.
+    fn collapsed(
+        engine: &RetrievalEngine<'_>,
+        mut container: Symbol,
+        mut leaves: Vec<Pooled>,
+    ) -> anyhow::Result<Pooled> {
+        engine.complete(std::iter::once(&mut container))?;
+        leaves.sort_by(|a, b| {
+            b.candidate
+                .score
+                .partial_cmp(&a.candidate.score)
+                .unwrap_or(std::cmp::Ordering::Equal)
+                .then_with(|| a.candidate.symbol.id().cmp(&b.candidate.symbol.id()))
+        });
+        let role = leaves
+            .iter()
+            .map(|l| l.role)
+            .min_by_key(|r| r.rank())
+            .unwrap_or(Role::Primary);
+        let mut reasons: Vec<Reason> = Vec::new();
+        for l in &leaves {
+            for r in &l.candidate.reasons {
+                if !reasons.contains(r) {
+                    reasons.push(r.clone());
+                }
+            }
+        }
+        Ok(Pooled {
+            candidate: Candidate {
+                symbol: container,
+                score: leaves.first().map_or(0.0, |l| l.candidate.score),
+                reasons,
+            },
+            role,
+        })
+    }
+
+    /// Step 5: one-hop neighbors of the first 5 selected items, production's
+    /// caps and score, skipping pooled ids; then production's dedup rules
+    /// (module subsumption, >80 % overlap) against the selected items and
+    /// earlier neighbors, and the relevance floor.
+    fn expand(
+        engine: &RetrievalEngine<'_>,
+        graph: &RelationGraph<'_>,
+        offers: &[(Pooled, &'static str)],
+        pooled: &HashSet<u64>,
+        floor: Option<f32>,
+        dropped: &mut Vec<Omitted>,
+    ) -> anyhow::Result<Vec<Pooled>> {
+        let mut seen: HashSet<u64> = pooled.clone();
+        seen.extend(offers.iter().map(|(c, _)| c.candidate.symbol.id()));
+        let mut admitted: Vec<Pooled> = Vec::new();
+        let mut total = 0usize;
+        for (anchor, _) in offers.iter().take(5) {
+            if total >= CONTEXT_EXPANSION_TOTAL {
+                break;
+            }
+            let mut from_anchor = 0usize;
+            for (rel, n) in graph.neighbors(&anchor.candidate.symbol) {
+                if total >= CONTEXT_EXPANSION_TOTAL || from_anchor >= CONTEXT_EXPANSION_PER_SEED {
+                    break;
+                }
+                if !seen.insert(n.id()) {
+                    continue;
+                }
+                from_anchor += 1;
+                total += 1;
+                let role = Role::assign(Origin::Expansion { relation: &rel }, n);
+                admitted.push(Pooled {
+                    candidate: Candidate {
+                        symbol: n.clone(),
+                        score: anchor.candidate.score * 0.4,
+                        reasons: vec![Reason::Related {
+                            relation: rel.clone(),
+                            seed: anchor.candidate.symbol.qualified_name.clone(),
+                        }],
+                    },
+                    role,
+                });
+            }
+        }
+        engine.complete(admitted.iter_mut().map(|c| &mut c.candidate.symbol))?;
+        let mut out: Vec<Pooled> = Vec::new();
+        for c in admitted {
+            let s = &c.candidate.symbol;
+            let cid = key(s);
+            let selected = offers.iter().map(|(o, _)| &o.candidate.symbol);
+            let concrete_in_file = selected
+                .clone()
+                .chain(out.iter().map(|o| &o.candidate.symbol))
+                .any(|o| o.file == s.file && o.kind != SymbolKind::Module);
+            if s.kind == SymbolKind::Module && concrete_in_file {
+                dropped.push(Omitted {
+                    id: cid,
+                    why: "module subsumed by concrete symbols".into(),
+                });
+                continue;
+            }
+            if selected
+                .chain(out.iter().map(|o| &o.candidate.symbol))
+                .any(|o| o.file == s.file && overlap_ratio(o, s) > 0.8)
+            {
+                dropped.push(Omitted {
+                    id: cid,
+                    why: "subsumed by overlapping symbol".into(),
+                });
+                continue;
+            }
+            if floor.is_some_and(|f| c.candidate.score < f) {
+                dropped.push(Omitted {
+                    id: cid,
+                    why: "below relevance floor".into(),
+                });
+                continue;
+            }
+            out.push(c);
+        }
+        Ok(out)
+    }
+}
