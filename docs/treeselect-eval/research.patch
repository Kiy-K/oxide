+//! #42 TreeSelect v0 pack harness (RESEARCH ONLY; docs/treeselect-eval/research.patch,
+//! never merged). Opens the corpus index read-only and runs the real
+//! `build_context_with` (balanced, no blast/git) per task with
+//! `context::treeselect_research` tracing on:
+//!   A      production selector, budget 4096 (no arm);
+//!   B      allocator-only control, budget = A's used_tokens;
+//!   TX     T=−x (TreeSelect order + collapse, production expansion), budget = A's;
+//!   T      T= (full TreeSelect v0), budget = A's;
+//!   TC     T=−c (T= without collapse), budget = A's;
+//!   T4096  T= at budget 4096.
+//! Every arm runs twice; `repeat_identical` compares the full pack JSON.
+//! Output, one line per task and arm: {id, arm, budget, used, trace, repeat_identical,
+//! context_ms: [ms, ms], search_ms}. `search_ms` is one timed `engine.search`
+//! (limit 50, hybrid, balanced), as in ch5.
+//!
+//! Usage: treeselect_pack <repo_root> <tasks.jsonl> [--arms A,B,TX,T,TC,T4096] > packs.jsonl
+//! Each input line: {"id", "query"}.
+use oxide::context::{build_context_with, treeselect_research as ts, ContextOptions};
+use oxide::embeddings::open_embedder;
+use oxide::retrieval::{RetrievalEngine, RetrievalMode, SearchMode, SearchOptions, SymbolSnapshot};
+use oxide::storage::SqliteStore;
+use serde_json::{json, Value};
+use std::io::{BufRead, Write};
+use std::time::Instant;
+
+fn main() -> anyhow::Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let root = std::path::PathBuf::from(&args[1]).canonicalize()?;
+    let tasks = std::io::BufReader::new(std::fs::File::open(&args[2])?);
+    let arms: Vec<String> = args
+        .iter()
+        .position(|a| a == "--arms")
+        .and_then(|i| args.get(i + 1).cloned())
+        .unwrap_or_else(|| "A,B,TX,T,TC,T4096".into())
+        .split(',')
+        .map(str::to_string)
+        .collect();
+    anyhow::ensure!(
+        arms.first().map(String::as_str) == Some("A"),
+        "arm A must run first"
+    );
+    let embedder = open_embedder(None)?;
+    let store = SqliteStore::open_read_only(&root.join(".oxide/index.db"))?;
+    let snapshot = SymbolSnapshot::load(&store)?;
+    let engine = RetrievalEngine::with_snapshot(&store, embedder.as_ref(), &snapshot);
+    let out = std::io::stdout();
+    let mut out = out.lock();
+    for line in tasks.lines() {
+        let line = line?;
+        if line.trim().is_empty() {
+            continue;
+        }
+        let task: Value = serde_json::from_str(&line)?;
+        let query = task["query"].as_str().unwrap_or_default().to_string();
+        let t = Instant::now();
+        engine.search(
+            &query,
+            &SearchOptions {
+                limit: 50,
+                mode: SearchMode::Hybrid,
+                expand: false,
+                retrieval_mode: RetrievalMode::Balanced,
+            },
+        )?;
+        let search_ms = t.elapsed().as_secs_f64() * 1e3;
+        let mut a_used = None;
+        for arm in &arms {
+            let (cfg, budget) = match arm.as_str() {
+                "A" => (None, 4096),
+                "T4096" => (Some(ts::T), 4096),
+                other => {
+                    let a = match other {
+                        "B" => ts::B,
+                        "TX" => ts::TX,
+                        "T" => ts::T,
+                        "TC" => ts::TC,
+                        _ => anyhow::bail!("unknown arm {other}"),
+                    };
+                    (Some(a), a_used.expect("arm A ran first"))
+                }
+            };
+            let opts = ContextOptions {
+                budget_tokens: budget,
+                ..ContextOptions::default()
+            };
+            let mut runs = Vec::new();
+            for _ in 0..2 {
+                ts::set(true, cfg);
+                let t = Instant::now();
+                let pack = build_context_with(&root, &engine, &query, &opts)?;
+                let ms = t.elapsed().as_secs_f64() * 1e3;
+                let trace = ts::take().unwrap_or(Value::Null);
+                ts::set(false, None);
+                runs.push((serde_json::to_string(&pack)?, pack.used_tokens, trace, ms));
+            }
+            if arm == "A" {
+                a_used = Some(runs[0].1);
+            }
+            let rec = json!({"id": task["id"], "arm": arm, "budget": budget, "used": runs[0].1,
+                "trace": runs[0].2, "repeat_identical": runs[0].0 == runs[1].0 && runs[0].2 == runs[1].2,
+                "context_ms": [runs[0].3, runs[1].3], "search_ms": search_ms});
+            writeln!(out, "{}", serde_json::to_string(&rec)?)?;
+        }
+    }
+    // Peak RSS for O1 (ch5's VmHWM).
+    if let Ok(status) = std::fs::read_to_string("/proc/self/status") {
+        if let Some(l) = status.lines().find(|l| l.starts_with("VmHWM:")) {
+            eprintln!("{l}");
+        }
+    }
+    Ok(())
+}
