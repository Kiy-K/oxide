#!/usr/bin/env bash
# Orb setup for OXIDE v2: mise (pinned like CI) -> uv (pinned in mise.toml) -> locked venv,
# the pinned FTS extension and the ContextBench corpora, i.e. `mise run bootstrap`.
set -euo pipefail
cd "$(dirname "$0")/.."

MISE_VERSION=2026.9.14
export PATH="$HOME/.local/bin:$PATH"

step() { printf '\n==> %s (%s)\n' "$1" "$(date +%T)"; }

step "mise $MISE_VERSION"
if ! command -v mise >/dev/null || ! mise --version | grep -q "^$MISE_VERSION "; then
  curl -fsSL https://mise.run | MISE_VERSION="v$MISE_VERSION" sh
fi

step "mise install (uv)"
mise trust --quiet mise.toml
mise install

step "mise run bootstrap (uv sync, oxide prepare, corpora)"
mise run bootstrap

# Persist mise's tool paths for the non-interactive login shells Amp and services start.
marker="# oxide: mise tool paths"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<PROFILE

$marker
export PATH="\$HOME/.local/bin:\$HOME/.local/share/mise/shims:\$PATH"
PROFILE
fi

step "done"
