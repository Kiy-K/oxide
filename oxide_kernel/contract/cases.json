[
  {
    "name": "status reaches the kernel",
    "request": "{\"version\":1,\"id\":\"a\",\"op\":\"status\"}",
    "response": { "version": 1, "id": "a", "ok": true, "result": { "kernel_version": "0.0.0" } }
  },
  {
    "name": "capabilities list the operations",
    "request": "{\"version\":1,\"id\":\"k\",\"op\":\"capabilities\"}",
    "response": {
      "version": 1,
      "id": "k",
      "ok": true,
      "result": {
        "protocol_version": 1,
        "operations": ["status", "capabilities", "open_repository", "close_repository"],
        "max_request_bytes": 1048576,
        "execution": "serial"
      }
    }
  },
  {
    "name": "operation without its params",
    "request": "{\"version\":1,\"id\":\"p\",\"op\":\"open_repository\"}",
    "response": {
      "version": 1,
      "id": "p",
      "ok": false,
      "error": { "code": "invalid_request", "message": "invalid params for `open_repository`" }
    }
  },
  {
    "name": "params on an operation that takes none",
    "request": "{\"version\":1,\"id\":\"q\",\"op\":\"status\",\"params\":{}}",
    "response": {
      "version": 1,
      "id": "q",
      "ok": false,
      "error": { "code": "invalid_request", "message": "invalid params for `status`" }
    }
  },
  {
    "name": "relative repository path",
    "request": "{\"version\":1,\"id\":\"r\",\"op\":\"open_repository\",\"params\":{\"path\":\"repo\"}}",
    "response": {
      "version": 1,
      "id": "r",
      "ok": false,
      "error": { "code": "invalid_path", "message": "repository path must be absolute" }
    }
  },
  {
    "name": "unknown repository handle",
    "request": "{\"version\":1,\"id\":\"u\",\"op\":\"close_repository\",\"params\":{\"handle\":\"0\"}}",
    "response": {
      "version": 1,
      "id": "u",
      "ok": false,
      "error": { "code": "unknown_handle", "message": "unknown repository handle" }
    }
  },
  {
    "name": "newer protocol version",
    "request": "{\"version\":2,\"id\":\"b\",\"op\":\"status\",\"future\":true}",
    "response": {
      "version": 1,
      "id": "b",
      "ok": false,
      "error": { "code": "unsupported_version", "message": "unsupported protocol version" }
    }
  },
  {
    "name": "unknown operation",
    "request": "{\"version\":1,\"id\":\"c\",\"op\":\"index\"}",
    "response": {
      "version": 1,
      "id": "c",
      "ok": false,
      "error": { "code": "unknown_operation", "message": "unknown operation" }
    }
  },
  {
    "name": "unknown envelope field",
    "request": "{\"version\":1,\"id\":\"d\",\"op\":\"status\",\"extra\":true}",
    "response": {
      "version": 1,
      "id": "d",
      "ok": false,
      "error": {
        "code": "invalid_request",
        "message": "request does not match the version 1 envelope"
      }
    }
  },
  {
    "name": "missing id",
    "request": "{\"version\":1,\"op\":\"status\"}",
    "response": {
      "version": 1,
      "id": null,
      "ok": false,
      "error": {
        "code": "invalid_request",
        "message": "request does not match the version 1 envelope"
      }
    }
  },
  {
    "name": "version is not an integer",
    "request": "{\"version\":\"1\",\"id\":\"e\",\"op\":\"status\"}",
    "response": {
      "version": 1,
      "id": "e",
      "ok": false,
      "error": { "code": "invalid_request", "message": "missing integer `version`" }
    }
  },
  {
    "name": "not JSON",
    "request": "{\"version\":1,",
    "response": {
      "version": 1,
      "id": null,
      "ok": false,
      "error": { "code": "invalid_request", "message": "request is not JSON" }
    }
  }
]
