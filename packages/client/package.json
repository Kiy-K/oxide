{
  "name": "@oxide/client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript client for the oxide binary's --json process boundary",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "test": "node --test \"test/*.test.ts\"",
    "test:integration": "node --test \"test/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oxide/native": "workspace:*",
    "@oxide/protocol": "workspace:*"
  }
}
