{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/mcp/**"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/fixtures/mcp/**"]
    },
    "compile": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**"]
    },
    "test:integration": {
      "dependsOn": ["compile"],
      "cache": false,
      "passThroughEnv": ["OXIDE_BIN"]
    }
  }
}
