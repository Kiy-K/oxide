# Per-symbol corpus manifests: ~35MB per provider capture (87,606 symbols x2),
# regenerable with scripts/agent_eval/capture_corpus_manifests.py. The small
# derived files beside them ARE committed — corpus/INDEX.txt (per-worktree
# symbol count + manifest sha256) and PROVENANCE.tsv (per-worktree embedder +
# fingerprint) — so the equality claim stays checkable without the bulk.
eval-agent/results/*/manifests_*/corpus/*.tsv
eval-agent/benchmark/results/
eval-agent/third_party/
eval-agent/.venv/
.oxide/
.codebase-memory/
__pycache__
/target
CLAUDE.local.md
.worktrees/
.env
eval-agent/agentbench/.run_tmp/
# TS workspace (#36): anchored to the workspace globs, because
# eval-agent/tasks/tsx_feat_button/node_modules is committed fixture content.
/node_modules/
/packages/*/node_modules/
/apps/*/node_modules/
.turbo/
/packages/*/dist/
# Built by `mise run native:build` (#36); never committed.
/packages/native/*.node
